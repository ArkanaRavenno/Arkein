---
import { QUICK_PROMPTS } from '../data/aiKnowledge';
---

<section id="neural-lab" class="space-y-8 scroll-mt-24">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto space-y-3" data-reveal>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-badge text-xs font-mono text-arctic-cobalt">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>03 / ARKEIN INTELLIGENCE PLAYGROUND</span>
    </div>
    <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight">
      Personal AI Assistant & <span class="text-transparent bg-clip-text bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum">Neural Core</span>
    </h2>
    <p class="text-slate-400 text-sm leading-relaxed">
      Konsol agen AI interaktif Arkana Ravenno. Didukung oleh integrasi <em>9Router Local Gateway</em> dengan inferensi adaptif, memori percakapan multi-turn, dan penalaran cerdas.
    </p>
  </div>

  <!-- Teaser Portal Frame -->
  <div class="glass-panel aurora-beam rounded-3xl overflow-hidden border border-arctic-cobalt/30 shadow-2xl relative" data-reveal data-reveal-delay="120">
    
    <!-- Top HUD Toolbar -->
    <div class="bg-void-900/95 border-b border-white/10 px-5 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 relative z-20">
      <div class="flex items-center gap-3">
        <div class="flex gap-1.5">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block shadow-sm"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block shadow-sm"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block shadow-sm"></span>
        </div>
        <span class="font-mono text-xs text-slate-300 font-semibold tracking-wide flex items-center gap-2">
          <span>arkein-ai://agent-gateway/v3.0</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </span>
      </div>

      <div class="flex items-center gap-2 font-mono text-xs">
        <div class="px-2.5 py-1 rounded-lg bg-arctic-cobalt/15 border border-arctic-cobalt/40 text-arctic-cobalt text-[10.5px] font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt animate-ping"></span>
          <span>9Router Local Gateway</span>
        </div>
      </div>
    </div>

    <!-- Interactive Teaser Body -->
    <div class="p-6 sm:p-8 bg-void-950/85 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      
      <!-- Left: Simulated Dynamic Agent Dialogue (7 Cols) -->
      <div class="md:col-span-7 space-y-4 font-mono text-xs">
        
        <!-- User Query Bubble -->
        <div class="flex flex-col items-end space-y-1">
          <div class="text-[9.5px] text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            <span>VISITOR // QUERY</span>
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
          </div>
          <div class="p-3.5 rounded-2xl bg-void-900 border border-arctic-cobalt/40 text-white max-w-[90%] leading-relaxed shadow-md">
            "Jelaskan arsitektur logistik DrivePass dan bagaimana sistem routing-nya dioptimalkan?"
          </div>
        </div>

        <!-- AI Agent Response Bubble -->
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-[10px] text-arctic-cobalt font-semibold tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
            <span>ARKEIN AI // AGENTIC INFERENCE</span>
          </div>
          <div class="p-4 rounded-2xl bg-void-900/90 border border-arctic-cobalt/30 text-slate-200 space-y-2.5 leading-relaxed shadow-lg">
            <p>
              <strong class="text-white">DrivePass</strong> menggunakan arsitektur <em>distributed dispatch</em> berbasis Next.js 14 App Router, Prisma ORM, dan PostgreSQL terisolasi.
            </p>
            <p class="text-slate-300 text-[11.5px]">
              Kalkulasi rute antar-hub di Jawa Timur mengintegrasikan Distance Matrix Service berlatensi <span class="text-sky-frost font-bold">&lt;100ms</span> dengan skema database relasional 100% type-safe.
            </p>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-slate-400">
              <span class="text-emerald-400">✓ Context Retention Active</span>
              <span>Tokens: 142 tok</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right: Call to Action & Features (5 Cols) -->
      <div class="md:col-span-5 space-y-5 border-t md:border-t-0 md:border-l border-white/10 pt-6 md:pt-0 md:pl-8">
        <div class="space-y-2">
          <h3 class="font-heading text-xl font-bold text-white tracking-tight">
            Eksplorasi di Halaman Khusus
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            AI Playground kini memiliki konsol mandiri dengan pengalaman layar penuh, inspektor model 9Router lokal, memori percakapan berlanjut, dan diagnostik telemetri lengkap.
          </p>
        </div>

        <!-- Highlights -->
        <div class="space-y-2 font-mono text-[11px] text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-arctic-cobalt">▸</span>
            <span>Terhubung ke 9Router lokal (Port 20128)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-arctic-cobalt">▸</span>
            <span>Memori percakapan multi-turn adaptif</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-arctic-cobalt">▸</span>
            <span>Real-time SSE token streaming</span>
          </div>
        </div>

        <!-- Launch Button -->
        <div class="pt-2">
          <a 
            href="/playground" 
            class="inline-flex items-center justify-center gap-2.5 w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum text-void-950 font-heading font-bold text-sm shadow-lg shadow-arctic-cobalt/25 hover:shadow-arctic-cobalt/50 hover:scale-[1.02] active:scale-[0.98] transition-all group"
          >
            <span>Buka AI Playground Mandiri</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
