---
// Hero component with Arctic Eclipse styling - Arkana Ravenno
---
<section id="hero" class="pt-16 pb-12 text-center md:text-left grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
  <div class="md:col-span-7 space-y-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-panel text-xs font-mono text-arctic-cobalt border-arctic-cobalt/30">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>SOFTWARE ENGINEERING STUDENT & TECH ENTHUSIAST</span>
    </div>
    
    <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
      Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum">Arkana Ravenno</span>.
      <span class="block text-2xl sm:text-3xl lg:text-4xl text-slate-300 font-semibold mt-2">Crafting Software & Exploring Modern Tech.</span>
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-xl font-normal leading-relaxed">
      Mahasiswa Software Engineering yang berdedikasi membangun aplikasi web modern, bereksperimen dengan arsitektur sistem, dan mengeksplorasi teknologi cerdas dengan perpaduan estetika visual dan performa tinggi.
    </p>

    <div class="flex flex-wrap gap-4 pt-2 justify-center md:justify-start">
      <a href="#about" class="btn-aurora px-6 py-3 rounded-xl bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum text-void-950 font-heading font-bold text-sm flex items-center gap-2 shadow-lg shadow-arctic-cobalt/25 transition-all">
        <span>Kenali Saya (About Me)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="#case-studies" class="px-6 py-3 rounded-xl glass-panel text-white font-heading font-semibold text-sm hover:border-arctic-cobalt/60 hover:shadow-[0_0_20px_rgba(96,165,250,0.3)] hover:-translate-y-1 transition-all flex items-center gap-2">
        Lihat Karya & Proyek
      </a>
    </div>

    <!-- Quick Spec Telemetry Bar -->
    <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/10 max-w-lg">
      <div>
        <div class="font-heading text-xl sm:text-2xl font-bold text-arctic-cobalt">SE Student</div>
        <div class="text-xs text-slate-400 font-mono">Software Engineering</div>
      </div>
      <div>
        <div class="font-heading text-xl sm:text-2xl font-bold text-sky-frost">Full-Stack</div>
        <div class="text-xs text-slate-400 font-mono">Web & Architecture</div>
      </div>
      <div>
        <div class="font-heading text-xl sm:text-2xl font-bold text-pure-platinum">Builder</div>
        <div class="text-xs text-slate-400 font-mono">Curious & Iterative</div>
      </div>
    </div>
  </div>

  <!-- Hero Visual Card: Interactive Developer Profile & Workspace Console -->
  <div class="md:col-span-5 relative" data-reveal data-reveal-delay="200">
    <div id="hero-telemetry-card" class="glass-panel aurora-beam p-6 sm:p-7 rounded-2xl border-white/10 relative overflow-hidden group cursor-pointer select-none">
      <!-- High-Tech Tactical HUD Corner Brackets (Expands on Hover) -->
      <span class="hud-bracket hud-tl absolute top-2.5 left-2.5 w-3 h-3 border-t-2 border-l-2 border-arctic-cobalt/50 transition-all duration-300 pointer-events-none z-20"></span>
      <span class="hud-bracket hud-tr absolute top-2.5 right-2.5 w-3 h-3 border-t-2 border-r-2 border-arctic-cobalt/50 transition-all duration-300 pointer-events-none z-20"></span>
      <span class="hud-bracket hud-bl absolute bottom-2.5 left-2.5 w-3 h-3 border-b-2 border-l-2 border-arctic-cobalt/50 transition-all duration-300 pointer-events-none z-20"></span>
      <span class="hud-bracket hud-br absolute bottom-2.5 right-2.5 w-3 h-3 border-b-2 border-r-2 border-arctic-cobalt/50 transition-all duration-300 pointer-events-none z-20"></span>

      <!-- Holographic Diagnostic Scanline Beam -->
      <div id="hero-scan-beam" class="hero-scan-beam" aria-hidden="true"></div>

      <!-- Interactive Specular Glare Layer -->
      <div id="hero-card-glare" class="hero-card-glare" aria-hidden="true"></div>

      <!-- Interactive Click Probe Sonar Container -->
      <div id="hero-probe-sonar" class="hero-probe-sonar" aria-hidden="true"></div>

      <!-- Glowing Ambient Orb in the background -->
      <div id="hero-orb" class="absolute -top-12 -right-12 w-48 h-48 bg-arctic-cobalt/15 rounded-full blur-2xl group-hover:bg-arctic-cobalt/40 transition-all duration-700 pointer-events-none" data-depth="-0.06"></div>

      <!-- Card Header -->
      <div class="hero-card-layer-header flex items-center justify-between mb-4 border-b border-white/10 pb-3 relative z-10" data-depth="0.08">
        <span class="font-mono text-xs text-arctic-cobalt font-semibold flex items-center gap-2.5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          DEVELOPER CONSOLE
        </span>
        <div class="flex items-center gap-2">
          <span id="hero-ping-badge" class="inline-block px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 transition-all">ONLINE</span>
          <span class="font-mono text-[10px] text-slate-400">DEV: Arkana</span>
        </div>
      </div>

      <!-- Telemetry Modules with Dynamic Waveform and Multi-Layer Parallax -->
      <div class="hero-card-layer-content space-y-3.5 font-mono text-xs relative z-10" data-depth="0.04">
        <!-- Module 1: Active Learning & Build Loop -->
        <div class="telemetry-item p-3 rounded-xl bg-void-950/70 border border-white/5 space-y-2 group-hover:border-arctic-cobalt/50 transition-all duration-300 relative overflow-hidden">
          <div class="flex justify-between items-center text-slate-300">
            <span class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
              Workspace Activity
            </span>
            <span class="text-arctic-cobalt font-semibold flex items-center gap-1.5">
              <span class="text-[10px] text-slate-400 font-normal">MODE</span>
              <span id="hero-agent-status" class="text-emerald-400 font-bold">Building</span>
            </span>
          </div>

          <!-- Dynamic Live Neural Activity Waveform (Math-Synthesized Real-Time SVG) -->
          <div class="relative h-6 w-full overflow-hidden rounded bg-void-900/80 border border-white/5 flex items-center px-2 group-hover:border-sky-frost/30 transition-colors">
            <svg id="hero-neural-wave-svg" class="w-full h-5 stroke-arctic-cobalt fill-none stroke-[1.8]" viewBox="0 0 300 24" preserveAspectRatio="none">
              <path id="hero-neural-wave-path" class="neural-wave-path" d="M0,12 L300,12" />
            </svg>
            <div id="hero-tok-counter" class="absolute right-2 text-[9px] font-mono text-arctic-cobalt tracking-wider font-semibold bg-void-950/80 px-1 py-0.5 rounded border border-arctic-cobalt/30">48.2k ops/s</div>
          </div>

          <div class="w-full bg-slate-800/80 h-1.5 rounded-full overflow-hidden relative">
            <div class="bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum h-full w-[92%] relative">
              <div class="absolute inset-0 bg-white/40 animate-pulse"></div>
            </div>
          </div>
          <div class="flex justify-between text-[10px] text-slate-400">
            <span class="text-slate-400">Status: <span class="text-emerald-400">Active Coding</span></span>
            <span>Response: <span id="hero-latency-val" class="text-sky-frost font-bold transition-colors">142ms</span></span>
          </div>
        </div>

        <!-- Module 2: Tech Arsenal & Explorer Focus -->
        <div class="telemetry-item p-3 rounded-xl bg-void-950/70 border border-white/5 space-y-1.5 group-hover:border-sky-frost/50 transition-all duration-300">
          <div class="flex justify-between text-slate-300">
            <span class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-frost"></span>
              Primary Tech Stack
            </span>
            <span class="text-sky-frost font-bold">Web & Systems</span>
          </div>
          <div class="w-full bg-slate-800/80 h-1.5 rounded-full overflow-hidden relative">
            <div class="bg-gradient-to-r from-sky-frost to-arctic-cobalt h-full w-[88%]"></div>
          </div>
          <div class="flex justify-between text-[10px] text-slate-400">
            <span>TypeScript • Astro • React • Python</span>
            <span class="text-emerald-400">Continuous Growth</span>
          </div>
        </div>

        <!-- Module 3: Current Focus & Objective -->
        <div class="telemetry-item p-3 rounded-xl bg-void-950/70 border border-white/5 flex items-center justify-between group-hover:border-pure-platinum/50 transition-all duration-300">
          <div>
            <div class="text-slate-300 font-semibold">Current Endeavor</div>
            <div class="text-[10px] text-slate-400">Building Scalable Apps & Polished UI</div>
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-500/15 border border-arctic-cobalt/30 text-arctic-cobalt text-[10px] font-semibold group-hover:border-arctic-cobalt group-hover:bg-blue-500/25 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt animate-pulse"></span>
            Iterating
          </div>
        </div>
      </div>

      <!-- Bottom Hint -->
      <div class="mt-3.5 pt-2 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-slate-500 relative z-10">
        <span>CLICK CARD TO PROBE PING</span>
        <span class="text-arctic-cobalt/80">[ INTERACTIVE CONSOLE ]</span>
      </div>
    </div>
  </div>
</section>

