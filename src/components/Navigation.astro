    </div>

    <div class="flex items-center gap-3 shrink-0 whitespace-nowrap">
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full glass-badge text-[11px] font-mono text-arctic-cobalt whitespace-nowrap shrink-0">
        <span class="w-2 h-2 rounded-full bg-arctic-cobalt animate-ping shrink-0"></span>
        <span class="whitespace-nowrap">AVAILABLE FOR WORK</span>
      </div>
      <a href="https://github.com/ArkanaRavenno" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-full bg-arctic-cobalt text-void-950 font-heading font-semibold text-xs hover:bg-sky-300 transition-all shadow-md shadow-arctic-cobalt/25 whitespace-nowrap shrink-0">
