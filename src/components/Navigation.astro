---
// Navigation dock with Arctic Eclipse Aurora Glass styling
---
<header class="fixed top-5 inset-x-0 z-50 flex justify-center px-4">
  <nav class="glass-panel px-5 md:px-6 py-2.5 rounded-full flex items-center justify-between gap-4 md:gap-8 max-w-5xl w-full border border-white/10 shadow-2xl whitespace-nowrap">
    <a href="#hero" class="flex items-center gap-2.5 group shrink-0 whitespace-nowrap">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-arctic-cobalt via-sky-frost to-pure-platinum flex items-center justify-center font-heading font-bold text-void-950 text-sm shadow-lg shadow-arctic-cobalt/25 group-hover:scale-105 transition-transform shrink-0">
        A
      </div>
      <span class="font-heading font-bold text-white tracking-wider text-sm sm:text-base leading-none">ARKEIN</span>
    </a>

    <div class="hidden md:flex items-center gap-4 lg:gap-6 font-mono text-xs text-slate-300 whitespace-nowrap">
      <a href="#philosophy" class="hover:text-arctic-cobalt transition-colors whitespace-nowrap">01. PHILOSOPHY</a>
      <a href="#neural-lab" class="hover:text-arctic-cobalt transition-colors flex items-center gap-1.5 text-arctic-cobalt whitespace-nowrap">
