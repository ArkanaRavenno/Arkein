---
// Navigation dock with Arctic Eclipse Aurora Glass styling
---
<header class="fixed top-5 inset-x-0 z-50 flex justify-center px-4">
  <nav class="glass-panel px-5 md:px-6 py-2.5 rounded-full flex items-center justify-between gap-4 md:gap-8 max-w-5xl w-full border border-white/10 shadow-2xl whitespace-nowrap">
    <a href="#hero" class="flex items-center gap-2.5 group shrink-0 whitespace-nowrap">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-arctic-cobalt via-sky-frost to-pure-platinum p-1.5 flex items-center justify-center shadow-lg shadow-arctic-cobalt/25 group-hover:scale-105 transition-transform shrink-0">
        <img src="/assets/logo-dark.png" alt="ARKEIN" class="w-full h-full object-contain" />
      </div>
      <span class="font-heading font-bold text-white tracking-wider text-sm sm:text-base leading-none">ARKEIN</span>
    </a>

    <div class="hidden md:flex items-center gap-3.5 lg:gap-5 font-mono text-xs text-slate-300 whitespace-nowrap">
      <a href="#about" class="hover:text-arctic-cobalt transition-colors whitespace-nowrap">01. ABOUT</a>
      <a href="#philosophy" class="hover:text-arctic-cobalt transition-colors whitespace-nowrap">02. PHILOSOPHY</a>
      <a href="#neural-lab" class="hover:text-arctic-cobalt transition-colors flex items-center gap-1.5 text-arctic-cobalt whitespace-nowrap">
        <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt animate-pulse shrink-0"></span>
        <span class="whitespace-nowrap">03. NEURAL LAB</span>
      </a>
      <a href="#case-studies" class="hover:text-arctic-cobalt transition-colors whitespace-nowrap">04. PROJECTS</a>
      <a href="#stack" class="hover:text-arctic-cobalt transition-colors whitespace-nowrap">05. STACK</a>
    </div>

    <div class="flex items-center gap-3 shrink-0 whitespace-nowrap">
      <a href="#contact" class="px-4 py-1.5 rounded-full bg-arctic-cobalt text-void-950 font-heading font-semibold text-xs hover:bg-sky-300 transition-all shadow-md shadow-arctic-cobalt/25 whitespace-nowrap shrink-0">
        Contact
      </a>
    </div>
  </nav>
</header>
