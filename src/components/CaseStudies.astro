---
import { projects } from '../data/projects';
---
<section id="case-studies" class="space-y-10 scroll-mt-24">
  <!-- Section Header -->
  <div class="space-y-3" data-reveal>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-badge text-xs font-mono text-arctic-cobalt">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>04 / FEATURED PROJECTS & REPOSITORIES</span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Engineered for <span class="text-transparent bg-clip-text bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum">Real-World Impact</span>
        </h2>
        <p class="text-slate-400 text-sm max-w-xl mt-2 leading-relaxed">
          Koleksi proyek terpilih dari GitHub: arsitektur dispatch logistik multi-hub, antarmuka web performa tinggi berbasis Astro & GSAP, hingga platform web interaktif.
        </p>
      </div>
      <div class="hidden sm:flex items-center gap-2 font-mono text-xs text-slate-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>3 VERIFIED REPOSITORIES</span>
      </div>
    </div>
  </div>

  <!-- Compact 3-Column Responsive Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
    {projects.map((proj, idx) => {
      // Numerical targets for live count-up animation
      const countTarget = idx === 0 ? "99.4" : idx === 1 ? "60" : "100";
      const countPrefix = "";
      const countSuffix = idx === 0 ? "% Precision & Sub-100ms" : idx === 1 ? " FPS & 100/100 Vitals" : "% Client-Side Engine";
      const indexNumber = `0${idx + 1}`;

      return (
        <div 
          class="glass-panel case-study-card rounded-2xl p-5 border border-white/10 flex flex-col justify-between group cursor-pointer relative overflow-hidden select-none" 
          data-reveal 
          data-reveal-delay={(idx * 100).toString()}
          data-project-id={proj.id}
          onclick={`window.open('${proj.repoUrl}', '_blank', 'noopener,noreferrer')`}
        >
          <!-- Background Decorative Layer (Contained to prevent any layout stretching) -->
          <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
            <!-- Tactical HUD Corner Brackets -->
            <span class="cs-hud-bracket cs-hud-tl absolute top-2 left-2 w-2 h-2 border-t border-l border-arctic-cobalt/40 transition-all duration-300"></span>
            <span class="cs-hud-bracket cs-hud-tr absolute top-2 right-2 w-2 h-2 border-t border-r border-arctic-cobalt/40 transition-all duration-300"></span>
            <span class="cs-hud-bracket cs-hud-bl absolute bottom-2 left-2 w-2 h-2 border-b border-l border-arctic-cobalt/40 transition-all duration-300"></span>
            <span class="cs-hud-bracket cs-hud-br absolute bottom-2 right-2 w-2 h-2 border-b border-r border-arctic-cobalt/40 transition-all duration-300"></span>

            <!-- Specular Glare & Ambient Glow -->
            <div class="cs-card-glare"></div>
            <div class="cs-ambient-glow"></div>
            <div class="cs-scan-line"></div>

            <!-- Blueprint Circuit Vector Trace -->
            <svg class="blueprint-circuit-svg absolute right-0 bottom-0 w-36 h-24 opacity-15 group-hover:opacity-35 transition-all duration-500" viewBox="0 0 200 140" fill="none">
              <path class="circuit-wire" d="M10,130 H60 L90,100 H140 L160,80 V20 H190" stroke="rgba(56, 189, 248, 0.7)" stroke-width="1.5" stroke-dasharray="300" stroke-dashoffset="300" />
              <path class="circuit-wire-2" d="M40,135 L80,95 H120 L150,65 H190" stroke="rgba(96, 165, 250, 0.5)" stroke-width="1" stroke-dasharray="250" stroke-dashoffset="250" />
              <circle cx="190" cy="20" r="3" fill="#38bdf8" class="circuit-node" />
              <circle cx="10" cy="130" r="2.5" fill="#60a5fa" class="circuit-node" />
            </svg>
          </div>

          <!-- Top Section: Meta + Title + Short Excerpt + Tech Stack -->
          <div class="space-y-3 relative z-10">
            <!-- Header Badge & Tag -->
            <div class="flex items-center justify-between border-b border-white/5 pb-2.5">
              <div class="flex items-center gap-1.5">
                <span class="px-1.5 py-0.5 rounded-md bg-void-950/80 border border-arctic-cobalt/30 text-arctic-cobalt font-mono text-[10px] font-bold">
                  {indexNumber}
                </span>
                {proj.branch && (
                  <span class="px-1.5 py-0.5 rounded-md bg-void-900 border border-white/10 text-slate-400 font-mono text-[9px] flex items-center gap-1">
                    <svg class="w-2.5 h-2.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 9a9 9 0 0 0 9 9"/></svg>
                    {proj.branch}
                  </span>
                )}
              </div>
              <span class={`text-[9.5px] font-mono ${proj.tagColor} tracking-wider uppercase font-semibold group-hover:brightness-125 transition-all truncate max-w-[190px]`}>
                {proj.tag}
              </span>
            </div>

            <!-- Title & Brief Architecture -->
            <div>
              <h3 class="font-heading text-base sm:text-lg font-bold text-white group-hover:text-sky-300 transition-colors leading-snug line-clamp-1">
                {proj.title}
              </h3>
              <p class="text-xs text-slate-300 mt-1.5 leading-relaxed line-clamp-2">
                {proj.architecture}
              </p>
            </div>

            <!-- Tech Stack Chips (Compact) -->
            <div class="flex flex-wrap gap-1 pt-0.5">
              {proj.stack.map(tech => (
                <span class="tech-chip px-2 py-0.5 rounded-md bg-void-950/70 border border-white/10 text-[10px] font-mono text-slate-300 hover:border-arctic-cobalt/60 hover:bg-arctic-cobalt/15 hover:text-white transition-all">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Section: Streamlined Metric Impact Strip -->
          <div class="pt-3.5 mt-3.5 border-t border-white/10 relative z-10">
            <div class="p-2.5 rounded-xl bg-void-950/80 border border-arctic-cobalt/25 group-hover:border-arctic-cobalt/60 transition-all duration-300 flex items-center justify-between gap-3">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 text-[9px] font-mono text-slate-400 uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
                  <span>VERIFIED IMPACT</span>
                </div>
                <div 
                  class="impact-counter text-arctic-cobalt font-heading font-bold text-sm sm:text-base group-hover:text-sky-300 transition-colors tracking-tight truncate mt-0.5"
                  data-target-num={countTarget}
                  data-prefix={countPrefix}
                  data-suffix={countSuffix}
                  data-static-text={proj.impactBadge}
                >
                  {proj.impactBadge}
                </div>
              </div>

              <!-- GitHub Repo Button -->
              <a 
                href={proj.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-2.5 py-1.5 rounded-lg bg-void-900 border border-arctic-cobalt/35 hover:border-arctic-cobalt hover:bg-arctic-cobalt/20 text-sky-frost hover:text-white font-mono text-[10px] font-semibold flex items-center gap-1.5 transition-all shrink-0 z-20 group/btn shadow-sm"
                onclick="event.stopPropagation()"
                title={`Buka ${proj.title} di GitHub`}
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                <span>Repo</span>
                <svg class="w-2.5 h-2.5 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>
