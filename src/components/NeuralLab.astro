    // Local Query Resolver
    function resolveLocally(queryText) {
      const q = queryText.toLowerCase().trim();
      let bestItem = null;
      let highestScore = 0;

      for (const item of knowledgeVault) {
        let score = 0;
        for (const kw of item.keywords) {
          if (q.includes(kw)) {
            score += kw.length > 4 ? 3 : 1;
          }
        }
        if (score > highestScore) {
          highestScore = score;
          bestItem = item;
        }
      }

      if (bestItem && highestScore >= 1) {
        return {
          reasoning: bestItem.reasoning,
          answer: bestItem.answer,
          tokens: Math.round(bestItem.answer.length / 3.8)
        };
      }

      return {
        reasoning: [
          "⚡ [Intent Analysis] Query di luar cakupan knowledge vault primer Arkana.",
          "🔍 [Neural Evaluation] Mengakses wawasan rekayasa perangkat lunak umum...",
          "🧠 [Synthesis] Merumuskan respons kontekstual dari sudut pandang Arkana."
        ],
        answer: "Terima kasih atas pertanyaannya! Sebagai representasi digital Arkana Ravenno, fokus rekayasa kami berakar pada **arsitektur sistem deterministik, performa terukur, dan kebersihan logika kode**.\n\nJika Anda ingin mengeksplorasi lebih jauh, Anda dapat melihat proyek **DrivePass** (sistem dispatch logistik berbasis Prisma & PostgreSQL) atau arsitektur web portofolio ini. Apakah ada aspek teknis spesifik yang ingin kita bahas?",
        tokens: 95
      };
    }

    // Execute Raw SSE Stream Request for a specific model
    async function executeStreamRequest(targetModel, targetEl, onUpdateStep) {
      const endpoint = `${gatewayUrl}/chat/completions`;
      
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${apiKey}`,
          'HTTP-Referer': window.location.origin || 'https://arkein.dev',
          'X-Title': 'Arkein Intelligence Core'
        },
        body: JSON.stringify({
          model: targetModel,
          messages: conversationHistory,
          stream: true,
          temperature: 0.7
        })
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        const errMsg = errorData.error?.message || `HTTP ${response.status}`;
        const err = new Error(errMsg);
        err.status = response.status;
        throw err;
      }

      onUpdateStep('🧠 [Model Streaming] Menerima aliran token dari ' + targetModel + '...');

      const reader = response.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let fullText = '';
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data:')) continue;
          const dataStr = trimmed.replace(/^data:\s*/, '');
          if (dataStr === '[DONE]') break;

          try {
            const parsed = JSON.parse(dataStr);
            const delta = parsed.choices?.[0]?.delta?.content || '';
            if (delta) {
              fullText += delta;
              targetEl.innerHTML = formatMarkdown(fullText);
              feed.scrollTop = feed.scrollHeight;
            }
          } catch (e) {
            // Buffer chunk
          }
        }
      }

      return fullText;
    }

    // Smart Model Rotation Wrapper (Handles 429 Rate Limits on Free Tier)
    async function streamWithSmartRotation(targetEl, onUpdateStep) {
      let candidateModels = [selectedModel];

      // If on OpenRouter, add alternative free models to the rotation list
      if (isOpenRouter()) {
        FREE_MODELS_POOL.forEach(m => {
          if (!candidateModels.includes(m)) candidateModels.push(m);
        });
      }

      let lastError = null;

      for (let i = 0; i < candidateModels.length; i++) {
        const currentCandidate = candidateModels[i];
        try {
          if (i > 0) {
            onUpdateStep(`🔄 [Model Rotation] Mengalihkan ke model cadangan gratis: ${currentCandidate}...`);
          }
          const text = await executeStreamRequest(currentCandidate, targetEl, onUpdateStep);
          // If a rotated alternative succeeded, update current model
          if (currentCandidate !== selectedModel) {
            selectedModel = currentCandidate;
            if (modelSelect) modelSelect.value = selectedModel;
            localStorage.setItem('arkein_9router_model', selectedModel);
            updateEngineUI();
          }
          return { text, usedModel: currentCandidate };
        } catch (err) {
          lastError = err;
          const isRateLimit = err.status === 429 || (err.message && err.message.toLowerCase().includes('rate limit'));
          if (isRateLimit && i < candidateModels.length - 1) {
            onUpdateStep(`⚠️ [HTTP 429 Rate Limit] Model ${currentCandidate} sibuk. Memutar ke cadangan gratis...`);
            continue;
          }
          throw err;
        }
      }

      throw lastError || new Error('Gateway tidak merespons');
    }

    // Typewriter Streamer Simulation for Local Fallback
    function streamTypewriter(targetElement, fullText, onComplete) {
      let index = 0;
      const step = 2;
      const speed = 12;

      function writeChunk() {
        index = Math.min(index + step, fullText.length);
        const currentSlice = fullText.slice(0, index);
        targetElement.innerHTML = formatMarkdown(currentSlice);
        feed.scrollTop = feed.scrollHeight;

        if (index < fullText.length) {
          setTimeout(writeChunk, speed);
        } else {
          if (onComplete) onComplete();
        }
      }
      writeChunk();
    }

    // Main Execution Flow (Agentic Adaptation & Multi-Turn Retention)
    async function handleUserQuery(userQuery) {
      if (!userQuery.trim() || isResponding) return;

      // Check Quota Guard first
      if (!consumeQuota()) {
        showStatusMsg('Batas kuota demo harian telah tercapai (10/10 credits). Buka Settings untuk Bring Your Own Key.', 'text-amber-400');
        return;
      }

      isResponding = true;
      submitBtn.disabled = true;
      input.disabled = true;

      if (statusIndicator) {
        statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span><span>REASONING & CONTEXT...</span>';
      }

      const startTime = performance.now();
      appendUserMessage(userQuery);
      input.value = '';

      // Register user query into Multi-Turn History
      conversationHistory.push({ role: 'user', content: userQuery });

      // Create Reasoning Matrix UI
      const reasoningBlock = appendReasoningBlock();
      const reasoningBox = reasoningBlock.querySelector('.reasoning-box');

      function addReasoningStep(stepText) {
        if (!reasoningBox) return;
        const item = document.createElement('div');
        item.textContent = stepText;
        reasoningBox.appendChild(item);
      }

      // Create Response Bubble Placeholder
      const responseWrapper = document.createElement('div');
      responseWrapper.className = 'ai-response-msg space-y-2 pt-1';
      feed.appendChild(responseWrapper);
      feed.scrollTop = feed.scrollHeight;

      let answerText = '';
      let usedEngineLabel = (isOpenRouter() ? 'OpenRouter: ' : '9Router: ') + selectedModel;
      let estimatedTokens = 0;

      // Decide: External Gateway vs Local Core
      const canUseExternalGateway = isGatewayAvailable && apiKey && selectedModel !== 'local-fallback';

      if (canUseExternalGateway) {
        try {
          addReasoningStep(`⚡ [Intent & Memory] Menyelaraskan query dengan ${conversationHistory.length - 1} giliran konteks dialog...`);
          addReasoningStep(`🌐 [Gateway Route] Menghubungi ${isOpenRouter() ? 'OpenRouter Cloud' : '9Router Lokal'} (${selectedModel})...`);

          const providerTitle = isOpenRouter() ? 'OPENROUTER CLOUD' : '9ROUTER LOCAL';
          responseWrapper.innerHTML = `
            <div class="flex items-center justify-between text-[10px] text-arctic-cobalt font-semibold tracking-wider">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
                <span>ARKEIN AI // ${escapeHtml(selectedModel.toUpperCase())}</span>
              </span>
              <span class="text-emerald-400 font-mono text-[9px] flex items-center gap-1">
                <span class="w-1 h-1 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Streaming ${providerTitle}</span>
              </span>
            </div>
            <div class="response-content p-4 rounded-2xl bg-void-950/95 border border-arctic-cobalt/35 text-slate-200 leading-relaxed shadow-lg"></div>
          `;
          const responseContentEl = responseWrapper.querySelector('.response-content');

          if (statusIndicator) {
            statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span><span>STREAMING TOKENS...</span>';
          }

          const streamResult = await streamWithSmartRotation(responseContentEl, addReasoningStep);
          answerText = streamResult.text;
          usedEngineLabel = `${isOpenRouter() ? 'OpenRouter' : '9Router'}: ${streamResult.usedModel}`;
          estimatedTokens = Math.round(answerText.length / 3.8);

        } catch (err) {
          console.warn('Gateway streaming gagal, fallback ke Local Core:', err);
          addReasoningStep(`⚠️ [Auto-Fallback] Gateway/Model (${err.message}). Beralih otomatis ke Local Persona Core.`);
          usedEngineLabel = 'Local Core (Auto-Fallback)';

          const localRes = resolveLocally(userQuery);
          localRes.reasoning.forEach(r => addReasoningStep(r));
          answerText = localRes.answer;
          estimatedTokens = localRes.tokens;

          responseWrapper.innerHTML = `
            <div class="flex items-center justify-between text-[10px] text-arctic-cobalt font-semibold tracking-wider">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
                <span>ARKEIN AI // LOCAL PERSONA CORE</span>
              </span>
              <span class="text-amber-400 font-mono text-[9px]">Graceful Fallback</span>
            </div>
            <div class="response-content p-4 rounded-2xl bg-void-950/95 border border-arctic-cobalt/35 text-slate-200 leading-relaxed shadow-lg"></div>
          `;
          const responseContentEl = responseWrapper.querySelector('.response-content');
          await new Promise(res => streamTypewriter(responseContentEl, answerText, res));
        }
      } else {
        // Direct Local Persona Core
        const reasonReason = selectedModel === 'local-fallback'
          ? 'Mode Local Persona Core dipilih manual'
          : (!isGatewayAvailable ? 'Gateway offline/tidak terjangkau' : 'API key belum disetel (BYOK)');
        addReasoningStep(`⚡ [Local Core] ${reasonReason}. Menggunakan inferensi Local Persona Vault...`);
        usedEngineLabel = 'Local Persona Core';

        const localRes = resolveLocally(userQuery);
        localRes.reasoning.forEach(r => addReasoningStep(r));
        answerText = localRes.answer;
        estimatedTokens = localRes.tokens;

        responseWrapper.innerHTML = `
          <div class="flex items-center justify-between text-[10px] text-arctic-cobalt font-semibold tracking-wider">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
              <span>ARKEIN AI // LOCAL PERSONA CORE</span>
            </span>
            <span class="text-sky-300 font-mono text-[9px]">Deterministic Instant</span>
          </div>
          <div class="response-content p-4 rounded-2xl bg-void-950/95 border border-arctic-cobalt/35 text-slate-200 leading-relaxed shadow-lg"></div>
        `;
        const responseContentEl = responseWrapper.querySelector('.response-content');

        if (statusIndicator) {
          statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span><span>STREAMING LOCAL...</span>';
        }

        await new Promise(res => streamTypewriter(responseContentEl, answerText, res));
      }

      // Save assistant response into Multi-Turn History
      conversationHistory.push({ role: 'assistant', content: answerText });

      // Keep conversation sliding window bounded (max 12 messages + system prompt)
      if (conversationHistory.length > 13) {
        conversationHistory = [
          conversationHistory[0],
          ...conversationHistory.slice(conversationHistory.length - 12)
        ];
      }

      // Finish Telemetry
      const elapsed = Math.round(performance.now() - startTime);
      if (latencyEl) latencyEl.textContent = `${elapsed} ms`;
      if (tokensEl) tokensEl.textContent = `${estimatedTokens} tok`;
      if (engineEl) engineEl.textContent = usedEngineLabel;
      if (turnsEl) {
        const userCount = conversationHistory.filter(m => m.role === 'user').length;
        turnsEl.textContent = `${userCount} turn${userCount !== 1 ? 's' : ''}`;
      }

      if (statusIndicator) {
        statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span>READY // LISTENING</span>';
      }

      isResponding = false;
      submitBtn.disabled = false;
      input.disabled = false;
      input.focus();
      feed.scrollTop = feed.scrollHeight;
    }

    // Form Submit Event
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        handleUserQuery(input.value);
      });
    }

    // Quick Chip Click Event
    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const query = chip.getAttribute('data-query');
        if (query) {
          handleUserQuery(query);
        }
      });
    });

    // Reset Chat Event (Clear Context Memory)
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (isResponding) return;
        conversationHistory = [
          { role: 'system', content: systemPersonaPrompt }
        ];

        feed.innerHTML = `
          <div class="ai-msg space-y-2">
            <div class="flex items-center gap-2 text-[10px] text-arctic-cobalt font-semibold tracking-wider">
              <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
              <span>ARKEIN AI // INTELLIGENCE AGENT</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-void-950/90 border border-arctic-cobalt/25 text-slate-200 space-y-2 leading-relaxed shadow-md">
              <p>
                Halo! Saya adalah <strong class="text-white">Arkein Intelligence Core</strong>, autonomous AI agent resmi dari <strong>Arkana Ravenno</strong> ⚡
              </p>
              <p class="text-slate-300 text-[11.5px]">
                Memori percakapan telah direset. Tanyakan apa saja mengenai arsitektur sistem <span class="text-sky-frost">DrivePass</span>, portofolio ini, atau filosofi rekayasanya.
              </p>
            </div>
          </div>
        `;
        if (latencyEl) latencyEl.textContent = '0 ms';
        if (tokensEl) tokensEl.textContent = '0 tok';
        if (turnsEl) turnsEl.textContent = '0 turns';
        if (statusIndicator) {
          statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span>READY // LISTENING</span>';
        }
      });
    }

  })();
</script>
