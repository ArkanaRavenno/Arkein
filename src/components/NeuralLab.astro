          fallbackOpt.value = 'local-fallback';
          fallbackOpt.textContent = '-- Local Persona Core (Offline Fallback) --';
          modelSelect.appendChild(fallbackOpt);

          if (!models.includes(currentVal)) {
            selectedModel = models.includes('google/gemini-2.0-flash-exp:free') 
              ? 'google/gemini-2.0-flash-exp:free' 
              : (models.includes('ag/gemini-3.8-flash') ? 'ag/gemini-3.8-flash' : models[0]);
            modelSelect.value = selectedModel;
            localStorage.setItem('arkein_9router_model', selectedModel);
