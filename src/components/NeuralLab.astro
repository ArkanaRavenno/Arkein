    // Sanitize user text to prevent XSS
    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Format markdown into styled HTML with safe formatting
    function formatMarkdown(text) {
      let escaped = escapeHtml(text);
      // Codeblocks ```lang ... ```
      escaped = escaped.replace(/```([\w]*)\n([\s\S]*?)```/g, '<pre class="my-2 p-3 rounded-xl bg-void-900 border border-white/10 font-mono text-[11px] text-sky-200 overflow-x-auto"><code>$2</code></pre>');
      // Bold **text**
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
      // Inline code `code`
      escaped = escaped.replace(/`(.*?)`/g, '<code class="px-1.5 py-0.5 rounded bg-void-950 border border-white/10 text-sky-300 font-mono text-[11px]">$1</code>');
      // Markdown list bullets
      escaped = escaped.replace(/^[*-]\s+(.+)$/gm, '<li class="ml-4 list-disc text-slate-300">$1</li>');
      // Line breaks
      escaped = escaped.replace(/\n\n/g, '<br/><br/>');
      escaped = escaped.replace(/\n/g, '<br/>');
      return escaped;
    }

