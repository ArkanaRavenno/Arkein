---
import { QUICK_PROMPTS, KNOWLEDGE_VAULT, SYSTEM_PERSONA_PROMPT } from '../data/aiKnowledge';
---
<section id="neural-lab" class="space-y-8 scroll-mt-24">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto space-y-3" data-reveal>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-badge text-xs font-mono text-arctic-cobalt">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>03 / ARKEIN INTELLIGENCE PLAYGROUND</span>
    </div>
    <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight">
      Personal AI Assistant & <span class="text-transparent bg-clip-text bg-gradient-to-r from-arctic-cobalt via-sky-frost to-pure-platinum">Neural Core</span>
    </h2>
    <p class="text-slate-400 text-sm leading-relaxed">
      Konsol agen AI interaktif Arkana Ravenno. Didukung oleh integrasi <em>9Router Local Gateway</em> dengan inferensi adaptif, memori multi-turn percakapan, dan streaming real-time.
    </p>
  </div>

  <!-- Main Terminal Console Frame -->
  <div class="glass-panel aurora-beam rounded-2xl overflow-hidden border border-arctic-cobalt/30 shadow-2xl relative" data-reveal data-reveal-delay="120">
    
    <!-- Top HUD Toolbar -->
    <div class="bg-void-900/95 border-b border-white/10 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 relative z-20">
      <div class="flex items-center gap-3">
        <div class="flex gap-1.5">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block shadow-sm"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block shadow-sm"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block shadow-sm"></span>
        </div>
        <span class="font-mono text-xs text-slate-300 font-semibold tracking-wide flex items-center gap-2">
          <span>arkein-ai://agent-terminal/v3.0</span>
          <span id="gateway-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" title="Gateway Status"></span>
        </span>
      </div>

      <!-- Controls: Engine Selector & Actions -->
      <div class="flex items-center gap-2 font-mono text-xs">
        <!-- Active Engine / Model Badge -->
        <div id="engine-badge" class="px-2.5 py-1 rounded-lg bg-arctic-cobalt/15 border border-arctic-cobalt/40 text-arctic-cobalt text-[10.5px] font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt animate-ping"></span>
          <span id="engine-name">9Router: Detect...</span>
        </div>

        <!-- 9Router Config Modal Toggle Button -->
        <button 
          id="btn-toggle-config" 
          type="button" 
          class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 hover:border-arctic-cobalt/40 text-slate-300 hover:text-white transition-all text-[11px] flex items-center gap-1.5 cursor-pointer"
          title="Konfigurasi 9Router Lokal"
        >
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="hidden sm:inline">Settings</span>
        </button>

        <!-- Reset Chat Button -->
        <button 
          id="btn-reset-chat" 
          type="button" 
          class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 hover:border-rose-400/40 text-slate-300 hover:text-rose-300 transition-all text-[11px] flex items-center gap-1 cursor-pointer"
          title="Reset Memori Percakapan"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span class="hidden sm:inline">Reset</span>
        </button>
      </div>
    </div>

    <!-- Collapsible Settings Panel for 9Router Configuration -->
    <div id="config-drawer" class="hidden bg-void-950/95 border-b border-arctic-cobalt/30 p-4 sm:p-5 relative z-20 font-mono text-xs transition-all">
      <div class="max-w-2xl mx-auto space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-white font-semibold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-arctic-cobalt"></span>
            Konfigurasi AI Gateway (9Router Lokal & OpenRouter Cloud)
          </span>
          <button id="btn-close-config" type="button" class="text-slate-400 hover:text-white cursor-pointer text-base">&times;</button>
        </div>

        <!-- Quick Provider Preset Switcher -->
        <div class="flex items-center gap-2 p-1.5 rounded-xl bg-void-900 border border-white/10 font-mono text-[11px]">
          <span class="text-slate-400 px-2 font-semibold">Pilih Provider:</span>
          <button 
            id="preset-openrouter-btn" 
            type="button" 
            class="px-3 py-1.5 rounded-lg bg-arctic-cobalt/20 text-white font-semibold border border-arctic-cobalt/40 hover:bg-arctic-cobalt/30 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
            <span>OpenRouter (Cloud 24/7)</span>
          </button>
          <button 
            id="preset-9router-btn" 
            type="button" 
            class="px-3 py-1.5 rounded-lg bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>9Router (Lokal)</span>
          </button>
        </div>

        <p id="gateway-info-desc" class="text-slate-400 text-[11px] leading-relaxed">
          Gunakan <strong>OpenRouter</strong> untuk hosting online 24/7 (tersedia model gratis seperti Gemini & Llama), atau <strong>9Router Lokal</strong> saat menjalankan di komputer lokal Anda.
        </p>

        <!-- Gateway URL & Model Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[10.5px] text-slate-300 mb-1 font-semibold">Gateway URL:</label>
            <div class="flex gap-1.5">
              <input 
                type="text" 
                id="router-url-input" 
                value="http://localhost:20128/v1" 
                placeholder="https://openrouter.ai/api/v1 atau http://localhost:20128/v1" 
                class="flex-1 px-3 py-2 rounded-xl bg-void-900 border border-white/10 text-white font-mono text-xs focus:border-arctic-cobalt focus:outline-none"
              />
              <button 
                id="btn-refresh-models" 
                type="button" 
                class="px-2.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 text-[11px] cursor-pointer"
                title="Pindai Model dari Gateway"
              >
                Pindai
              </button>
            </div>
          </div>

          <div>
            <label class="block text-[10.5px] text-slate-300 mb-1 font-semibold">Pilihan Model:</label>
            <select 
              id="router-model-select" 
              class="w-full px-3 py-2 rounded-xl bg-void-900 border border-white/10 text-white font-mono text-xs focus:border-arctic-cobalt focus:outline-none cursor-pointer"
            >
              <option value="google/gemini-2.0-flash-exp:free">google/gemini-2.0-flash-exp:free (OpenRouter Gratis)</option>
              <option value="meta-llama/llama-3.3-70b-instruct:free">meta-llama/llama-3.3-70b-instruct:free (OpenRouter Gratis)</option>
              <option value="deepseek/deepseek-r1:free">deepseek/deepseek-r1:free (OpenRouter Gratis)</option>
              <option value="ag/gemini-3.8-flash">ag/gemini-3.8-flash (9Router Lokal)</option>
              <option value="local-fallback">Local Persona Core (Offline Fallback)</option>
            </select>
          </div>
        </div>

        <!-- API Key Input -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-[10.5px] text-slate-300 font-semibold">API Key:</label>
            <a 
              id="gateway-dashboard-link"
              href="https://openrouter.ai/keys" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-[10px] text-sky-400 hover:underline flex items-center gap-1"
            >
              <span id="gateway-dashboard-label">Dapatkan API Key di OpenRouter (openrouter.ai/keys)</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <input 
              type="password" 
              id="router-key-input" 
              placeholder="sk-or-v1-... (OpenRouter) atau API Key 9Router..." 
              class="flex-1 px-3 py-2 rounded-xl bg-void-900 border border-white/10 text-white font-mono text-xs focus:border-arctic-cobalt focus:outline-none"
            />
            <div class="flex gap-2">
              <button id="btn-save-config" type="button" class="px-4 py-2 rounded-xl bg-arctic-cobalt text-void-950 font-bold hover:bg-sky-300 transition-all cursor-pointer">
                Simpan
              </button>
              <button id="btn-clear-key" type="button" class="px-3 py-2 rounded-xl bg-white/5 hover:bg-rose-500/20 text-slate-300 hover:text-rose-300 border border-white/10 transition-all cursor-pointer">
                Hapus Key
              </button>
            </div>
          </div>
        </div>

        <div id="config-status-msg" class="text-[11px] text-emerald-400 font-semibold hidden"></div>
      </div>
    </div>

    <!-- Chat & Telemetry Body -->
    <div class="p-4 sm:p-6 bg-void-950/85 flex flex-col space-y-4">
      
      <!-- Chat Messages Scroll Container -->
      <div 
        id="chat-feed" 
        class="h-96 sm:h-[440px] overflow-y-auto p-4 rounded-xl bg-void-900/90 border border-white/10 font-mono text-xs space-y-4 text-slate-200 leading-relaxed shadow-inner"
        role="log" 
        aria-live="polite"
      >
        <!-- Initial Welcome Bubble from Arkein AI -->
        <div class="ai-msg space-y-2">
          <div class="flex items-center gap-2 text-[10px] text-arctic-cobalt font-semibold tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-arctic-cobalt"></span>
            <span>ARKEIN AI // INTELLIGENCE AGENT</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-void-950/90 border border-arctic-cobalt/25 text-slate-200 space-y-2 leading-relaxed shadow-md">
            <p>
              Halo! Saya adalah <strong class="text-white">Arkein Intelligence Core</strong>, autonomous AI agent resmi dari <strong>Arkana Ravenno</strong> ⚡
            </p>
            <p class="text-slate-300 text-[11.5px]">
              Saya terhubung ke memori konteks dinamis. Anda dapat menanyakan detail arsitektur logistik <span class="text-sky-frost">DrivePass</span>, portofolio Arkein, atau berdiskusi bertahap selayaknya agent sungguhan.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Suggestion Prompt Chips -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[10.5px] font-mono text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
            <span>PROMPT CEPAT (KLIK UNTUK BERTANYA):</span>
          </span>
          <span class="text-slate-500 hidden sm:inline">1-Click Telemetry Probe</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="quick-chips-wrapper">
          {QUICK_PROMPTS.map(item => (
            <button 
              type="button" 
              class="quick-chip-btn px-2.5 py-1 rounded-lg bg-void-900 hover:bg-arctic-cobalt/20 border border-white/10 hover:border-arctic-cobalt/60 text-[11px] font-mono text-slate-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 select-none"
              data-query={item.query}
            >
              <span class="text-arctic-cobalt">&gt;</span>
              <span>{item.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Quota Exhausted Warning Banner (Hidden by default) -->
      <div id="quota-warning-banner" class="hidden p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs font-mono space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 font-semibold text-amber-300">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>Batas Kuota Demo Harian Tercapai (10/10 Pertanyaan)</span>
          </div>
          <span class="text-[10px] text-amber-400/80">Auto-reset 00:00 UTC</span>
        </div>
        <p class="text-[11.5px] text-slate-300 leading-relaxed font-sans">
          Untuk menjaga ketersediaan token publik, setiap sesi dibatasi 10 pertanyaan/hari. Anda dapat melanjutkan tanpa batas dengan memasukkan API Key pribadi (Bring Your Own Key) atau beralih ke representasi offline <strong>Local Persona Core</strong>.
        </p>
        <div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px]">
          <button id="banner-open-settings" type="button" class="px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Buka Settings (Gunakan Key Sendiri)</span>
          </button>
          <button id="banner-switch-local" type="button" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-all cursor-pointer flex items-center gap-1.5">
            <span>⚡ Beralih ke Local Persona Core</span>
          </button>
        </div>
      </div>

      <!-- Input Dock -->
      <form id="chat-form" class="space-y-2">
        <div class="relative flex items-center">
          <input 
            type="text" 
            id="chat-input" 
            placeholder="Tanyakan apa saja ke Arkana AI Agent (contoh: 'Jelaskan bagaimana DrivePass bekerja')..." 
            class="w-full pl-4 pr-24 py-3.5 rounded-xl bg-void-900 border border-white/10 text-white font-mono text-xs sm:text-sm placeholder:text-slate-500 focus:border-arctic-cobalt focus:ring-1 focus:ring-arctic-cobalt/50 focus:outline-none transition-all shadow-inner disabled:opacity-50 disabled:cursor-not-allowed"
            autocomplete="off"
            maxlength="400"
          />
          <button 
            type="submit" 
            id="chat-submit-btn" 
            class="absolute right-1.5 px-3.5 py-2 rounded-lg bg-gradient-to-r from-arctic-cobalt to-sky-frost text-void-950 font-mono font-bold text-xs flex items-center gap-1.5 hover:shadow-[0_0_15px_rgba(56,189,248,0.4)] transition-all cursor-pointer shrink-0 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span>Kirim</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </form>

      <!-- Live Telemetry Status Strip -->
      <div class="flex flex-wrap items-center justify-between pt-2 border-t border-white/5 font-mono text-[11px] text-slate-400 gap-2">
        <div class="flex items-center gap-3">
          <span>Latency: <strong id="telemetry-latency" class="text-white">0 ms</strong></span>
          <span>Tokens: <strong id="telemetry-tokens" class="text-white">0 tok</strong></span>
          <span>Quota: <strong id="telemetry-quota" class="text-sky-frost">10/10 credits</strong></span>
          <span class="hidden sm:inline">Context: <strong id="telemetry-turns" class="text-sky-frost">0 turns</strong></span>
          <span class="hidden md:inline">Gateway: <strong id="telemetry-engine" class="text-arctic-cobalt">Detecting...</strong></span>
        </div>
        <div id="ai-status-indicator" class="flex items-center gap-1.5 text-arctic-cobalt font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>READY // LISTENING</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client Side Runtime Engine Script -->
<script is:inline define:vars={{ knowledgeVault: KNOWLEDGE_VAULT, systemPersonaPrompt: SYSTEM_PERSONA_PROMPT }}>
  (function() {
    const feed = document.getElementById('chat-feed');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const submitBtn = document.getElementById('chat-submit-btn');
    const quickChips = document.querySelectorAll('.quick-chip-btn');
    const resetBtn = document.getElementById('btn-reset-chat');
    
    // Telemetry elements
    const latencyEl = document.getElementById('telemetry-latency');
    const tokensEl = document.getElementById('telemetry-tokens');
    const turnsEl = document.getElementById('telemetry-turns');
    const quotaEl = document.getElementById('telemetry-quota');
    const engineEl = document.getElementById('telemetry-engine');
    const engineNameEl = document.getElementById('engine-name');
    const gatewayDot = document.getElementById('gateway-status-dot');
    const statusIndicator = document.getElementById('ai-status-indicator');

    // Quota Guard elements & Constants
    const DAILY_QUOTA_LIMIT = 10;
    const FREE_MODELS_POOL = [
      'google/gemini-2.0-flash-exp:free',
      'meta-llama/llama-3.3-70b-instruct:free',
      'deepseek/deepseek-r1:free',
      'qwen/qwen-2.5-72b-instruct:free'
    ];
    const quotaBanner = document.getElementById('quota-warning-banner');
    const bannerOpenSettingsBtn = document.getElementById('banner-open-settings');
    const bannerSwitchLocalBtn = document.getElementById('banner-switch-local');

    // Config Drawer elements
    const toggleConfigBtn = document.getElementById('btn-toggle-config');
    const closeConfigBtn = document.getElementById('btn-close-config');
    const configDrawer = document.getElementById('config-drawer');
    const urlInput = document.getElementById('router-url-input');
    const modelSelect = document.getElementById('router-model-select');
    const keyInput = document.getElementById('router-key-input');
    const saveConfigBtn = document.getElementById('btn-save-config');
    const clearKeyBtn = document.getElementById('btn-clear-key');
    const refreshModelsBtn = document.getElementById('btn-refresh-models');
    const statusMsg = document.getElementById('config-status-msg');
    const presetOpenRouterBtn = document.getElementById('preset-openrouter-btn');
    const preset9RouterBtn = document.getElementById('preset-9router-btn');
    const dashboardLink = document.getElementById('gateway-dashboard-link');
    const dashboardLabel = document.getElementById('gateway-dashboard-label');
    const infoDesc = document.getElementById('gateway-info-desc');

    // State Variables
    let isResponding = false;
    let gatewayUrl = localStorage.getItem('arkein_9router_url') || 'http://localhost:20128/v1';
    let apiKey = localStorage.getItem('arkein_9router_key') || '';
    let selectedModel = localStorage.getItem('arkein_9router_model') || 'ag/gemini-3.8-flash';
    let isGatewayAvailable = false;

    // Multi-Turn Conversation Memory Array
    let conversationHistory = [
      { role: 'system', content: systemPersonaPrompt }
    ];

    // Initialize UI controls
    if (urlInput) urlInput.value = gatewayUrl;
    if (keyInput) keyInput.value = apiKey;

    // Detect Provider Type
    function isOpenRouter() {
      return gatewayUrl.includes('openrouter.ai');
    }

    // Quota Guard Helpers
    function getTodayString() {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function getQuotaData() {
      const today = getTodayString();
      const savedDate = localStorage.getItem('arkein_quota_date');
      let count = parseInt(localStorage.getItem('arkein_quota_count') || '0', 10);

      if (savedDate !== today) {
        count = 0;
        localStorage.setItem('arkein_quota_date', today);
        localStorage.setItem('arkein_quota_count', '0');
      }
      return { date: today, count };
    }

    function isUnlimitedUser() {
      return Boolean(apiKey && apiKey.trim().length > 0) || selectedModel === 'local-fallback';
    }

    function updateQuotaUI() {
      const { count } = getQuotaData();

      if (isUnlimitedUser()) {
        if (quotaEl) {
          quotaEl.textContent = 'Unlimited (BYOK/Local)';
          quotaEl.className = 'text-emerald-400 font-semibold';
        }
        if (quotaBanner) quotaBanner.classList.add('hidden');
        if (!isResponding && input && submitBtn) {
          input.disabled = false;
          submitBtn.disabled = false;
          input.placeholder = "Tanyakan apa saja ke Arkana AI Agent (contoh: 'Jelaskan bagaimana DrivePass bekerja')...";
        }
        return;
      }

      const remaining = Math.max(0, DAILY_QUOTA_LIMIT - count);
      if (quotaEl) {
