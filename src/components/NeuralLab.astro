          showStatusMsg(`Gateway aktif (${models.length} model terdeteksi).`, 'text-emerald-400');
        }
      } catch (err) {
        console.warn('Gateway tidak dapat dihubungi di:', gatewayUrl, err);
        // If OpenRouter, it's still available online even if unauthenticated /models scan is blocked
        if (isOpenRouter()) {
