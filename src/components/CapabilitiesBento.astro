---
// Capabilities Bento Matrix
---
<section id="stack" class="space-y-8 scroll-mt-24">
  <div class="space-y-3" data-reveal>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-badge text-xs font-mono text-arctic-cobalt">
      <span>05 / ENGINEERING CAPABILITIES MATRIX</span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white">
          Production Stack & <span class="text-arctic-cobalt">Capabilities</span>
        </h2>
        <p class="text-slate-400 text-sm max-w-xl mt-2 leading-relaxed">
          Arsitektur dan toolkit rekayasa yang terbukti diterapkan pada proyek GitHub nyata: dari performa antarmuka web modern hingga manajemen rute dan database relasional.
        </p>
      </div>
      <div class="hidden sm:flex items-center gap-2 font-mono text-xs text-slate-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>VERIFIED STACK ECOSYSTEM</span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group data-stagger-delay="120">
    <!-- Bento 01: Modern Frontend & Motion -->
    <div class="glass-panel bento-card reveal-item p-6 rounded-2xl border-white/10 space-y-4 group cursor-pointer relative overflow-hidden select-none" data-layer="FRONTEND_LAYER">
      <!-- Background Decorative Layers (Contained to avoid layout stretching) -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <!-- Tactical HUD Corner Brackets -->
        <span class="bento-hud-bracket bento-hud-tl absolute top-2 left-2 w-2 h-2 border-t border-l border-arctic-cobalt/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-tr absolute top-2 right-2 w-2 h-2 border-t border-r border-arctic-cobalt/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-bl absolute bottom-2 left-2 w-2 h-2 border-b border-l border-arctic-cobalt/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-br absolute bottom-2 right-2 w-2 h-2 border-b border-r border-arctic-cobalt/40 transition-all duration-300"></span>

        <!-- Specular Glare & Ambient Glow -->
        <div class="bento-card-glare"></div>
        <div class="bento-ambient-glow"></div>
        <div class="bento-scan-line"></div>
      </div>

      <div class="flex items-center justify-between relative z-10">
        <div class="w-10 h-10 rounded-xl bg-arctic-cobalt/10 border border-arctic-cobalt/30 flex items-center justify-center text-arctic-cobalt font-mono font-bold bento-badge">
          01
        </div>
        <span class="text-[10px] font-mono text-slate-400 group-hover:text-arctic-cobalt transition-colors bento-layer-tag" data-original="FRONTEND_LAYER">FRONTEND_LAYER</span>
      </div>
      <h3 class="font-heading text-xl font-bold text-white group-hover:text-arctic-cobalt transition-colors relative z-10">Modern Frontend & Motion</h3>
      
      <!-- Kinetic Tech Chips -->
      <div class="flex flex-wrap gap-1.5 pt-1 relative z-10 bento-chips-container">
        {["Astro", "Next.js 14", "React 18", "Tailwind CSS", "GSAP Physics", "TypeScript", "Responsive UI"].map(chip => (
          <span class="kinetic-chip px-2.5 py-1 rounded-lg bg-void-950/80 border border-white/5 text-[11px] font-mono text-slate-300 hover:border-arctic-cobalt/60 hover:text-white transition-all cursor-pointer">
            {chip}
          </span>
        ))}
      </div>

      <!-- Live Terminal Drawer Preview with Pulse Cursor -->
      <div class="pt-3 border-t border-white/5 font-mono text-[11px] space-y-1 bg-void-950/60 p-2.5 rounded-xl border border-white/5 group-hover:border-arctic-cobalt/40 transition-all bento-terminal-drawer relative z-10">
        <div class="text-slate-400 flex items-center justify-between">
          <span>$ astro build &amp;&amp; vite optimize</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <div class="text-arctic-cobalt font-semibold flex items-center gap-1">
          <span>&gt; 60 FPS motion &bull; Zero frame drop</span>
          <span class="inline-block w-1.5 h-3 bg-arctic-cobalt/80 animate-pulse"></span>
        </div>
      </div>
    </div>

    <!-- Bento 02: Backend & Systems Architecture -->
    <div class="glass-panel bento-card reveal-item p-6 rounded-2xl border-white/10 space-y-4 group cursor-pointer relative overflow-hidden select-none" data-layer="BACKEND_DATA_LAYER">
      <!-- Background Decorative Layers (Contained to avoid layout stretching) -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <!-- Tactical HUD Corner Brackets -->
        <span class="bento-hud-bracket bento-hud-tl absolute top-2 left-2 w-2 h-2 border-t border-l border-sky-frost/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-tr absolute top-2 right-2 w-2 h-2 border-t border-r border-sky-frost/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-bl absolute bottom-2 left-2 w-2 h-2 border-b border-l border-sky-frost/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-br absolute bottom-2 right-2 w-2 h-2 border-b border-r border-sky-frost/40 transition-all duration-300"></span>

        <!-- Specular Glare & Ambient Glow -->
        <div class="bento-card-glare"></div>
        <div class="bento-ambient-glow"></div>
        <div class="bento-scan-line"></div>
      </div>

      <div class="flex items-center justify-between relative z-10">
        <div class="w-10 h-10 rounded-xl bg-sky-frost/10 border border-sky-frost/30 flex items-center justify-center text-sky-frost font-mono font-bold bento-badge">
          02
        </div>
        <span class="text-[10px] font-mono text-slate-400 group-hover:text-sky-frost transition-colors bento-layer-tag" data-original="BACKEND_DATA_LAYER">BACKEND_DATA_LAYER</span>
      </div>
      <h3 class="font-heading text-xl font-bold text-white group-hover:text-sky-frost transition-colors relative z-10">Backend & Data Architecture</h3>
      
      <!-- Kinetic Tech Chips -->
      <div class="flex flex-wrap gap-1.5 pt-1 relative z-10 bento-chips-container">
        {["Node.js", "Prisma ORM", "PostgreSQL", "App Router", "Distance Matrix", "REST APIs", "MapLibre GL"].map(chip => (
          <span class="kinetic-chip px-2.5 py-1 rounded-lg bg-void-950/80 border border-white/5 text-[11px] font-mono text-slate-300 hover:border-sky-frost/60 hover:text-white transition-all cursor-pointer">
            {chip}
          </span>
        ))}
      </div>

      <!-- Live Terminal Drawer Preview with Pulse Cursor -->
      <div class="pt-3 border-t border-white/5 font-mono text-[11px] space-y-1 bg-void-950/60 p-2.5 rounded-xl border border-white/5 group-hover:border-sky-frost/40 transition-all bento-terminal-drawer relative z-10">
        <div class="text-slate-400 flex items-center justify-between">
          <span>$ npx prisma db push &amp;&amp; tsx seed.ts</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <div class="text-sky-frost font-semibold flex items-center gap-1">
          <span>&gt; Schema synced: East Java Hubs active</span>
          <span class="inline-block w-1.5 h-3 bg-sky-frost/80 animate-pulse"></span>
        </div>
      </div>
    </div>

    <!-- Bento 03: Engineering Standards & Tooling -->
    <div class="glass-panel bento-card reveal-item p-6 rounded-2xl border-white/10 space-y-4 group cursor-pointer relative overflow-hidden select-none" data-layer="DISCIPLINE_LAYER">
      <!-- Background Decorative Layers (Contained to avoid layout stretching) -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <!-- Tactical HUD Corner Brackets -->
        <span class="bento-hud-bracket bento-hud-tl absolute top-2 left-2 w-2 h-2 border-t border-l border-pure-platinum/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-tr absolute top-2 right-2 w-2 h-2 border-t border-r border-pure-platinum/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-bl absolute bottom-2 left-2 w-2 h-2 border-b border-l border-pure-platinum/40 transition-all duration-300"></span>
        <span class="bento-hud-bracket bento-hud-br absolute bottom-2 right-2 w-2 h-2 border-b border-r border-pure-platinum/40 transition-all duration-300"></span>

        <!-- Specular Glare & Ambient Glow -->
        <div class="bento-card-glare"></div>
        <div class="bento-ambient-glow"></div>
        <div class="bento-scan-line"></div>
      </div>

      <div class="flex items-center justify-between relative z-10">
        <div class="w-10 h-10 rounded-xl bg-pure-platinum/10 border border-pure-platinum/30 flex items-center justify-center text-pure-platinum font-mono font-bold bento-badge">
          03
        </div>
        <span class="text-[10px] font-mono text-slate-400 group-hover:text-pure-platinum transition-colors bento-layer-tag" data-original="DISCIPLINE_LAYER">DISCIPLINE_LAYER</span>
      </div>
      <h3 class="font-heading text-xl font-bold text-white group-hover:text-pure-platinum transition-colors relative z-10">Engineering Standards & Quality</h3>
      
      <!-- Kinetic Tech Chips -->
      <div class="flex flex-wrap gap-1.5 pt-1 relative z-10 bento-chips-container">
        {["Git / GitHub", "Vitest", "Type-Safety", "Clean Architecture", "PostCSS", "Tailwind v4", "Docs-as-Code"].map(chip => (
          <span class="kinetic-chip px-2.5 py-1 rounded-lg bg-void-950/80 border border-white/5 text-[11px] font-mono text-slate-300 hover:border-pure-platinum/60 hover:text-white transition-all cursor-pointer">
            {chip}
          </span>
        ))}
      </div>

      <!-- Live Terminal Drawer Preview with Pulse Cursor -->
      <div class="pt-3 border-t border-white/5 font-mono text-[11px] space-y-1 bg-void-950/60 p-2.5 rounded-xl border border-white/5 group-hover:border-pure-platinum/40 transition-all bento-terminal-drawer relative z-10">
        <div class="text-slate-400 flex items-center justify-between">
          <span>$ vitest run &amp;&amp; tsc --noEmit</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <div class="text-pure-platinum font-semibold flex items-center gap-1">
          <span>&gt; Tests passing: 100% type-safe verified</span>
          <span class="inline-block w-1.5 h-3 bg-pure-platinum/80 animate-pulse"></span>
        </div>
      </div>
    </div>
  </div>
</section>
