---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arkein — Full-Stack AI Engineer & System Architect",
  description = "Architecting Autonomous AI Systems, High-Throughput Inference Engines, and Interactive Web Applications."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body class="relative min-h-screen bg-void-950 selection:bg-arctic-cobalt selection:text-void-950 text-slate-200">
  <!-- Top Aurora Scroll Progress Laser -->
  <div id="scroll-progress-bar" style="width: 0%;"></div>

  <!-- Dynamic Aurora Background Engine -->
  <div class="aurora-container" aria-hidden="true">
    <div id="aurora-blob-1" class="aurora-blob-1"></div>
    <div id="aurora-blob-2" class="aurora-blob-2"></div>
    <div id="aurora-blob-3" class="aurora-blob-3"></div>
    <div id="aurora-mouse-spotlight" class="aurora-mouse-spotlight"></div>
  </div>
  
  <Navigation />
  
  <slot />

  <!-- GSAP Smooth Motion & Physics Engine Script -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initMotionEngine() {
      // 0. Clean up previous triggers to avoid duplicates on re-init
      ScrollTrigger.getAll().forEach(t => t.kill());

      // Reduced motion accessibility check
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('[data-reveal], [data-reveal-group] .reveal-item').forEach(el => {
          el.classList.add('revealed');
          gsap.set(el, { opacity: 1, y: 0, x: 0, scale: 1, rotationX: 0, rotationY: 0, filter: 'none' });
        });
      }

      // 1. Scroll Progress & Dynamic Aurora Parallax Drift
      const progressBar = document.getElementById('scroll-progress-bar');
      const blob1 = document.getElementById('aurora-blob-1');
      const blob2 = document.getElementById('aurora-blob-2');
      const blob3 = document.getElementById('aurora-blob-3');

      let ticking = false;
      function onScrollUpdate() {
        const scrollY = window.scrollY || window.pageYOffset;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        
        if (docHeight > 0 && progressBar) {
          const scrollPercent = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
          progressBar.style.width = scrollPercent + '%';
        }

        // Smooth GSAP Parallax Drift for Aurora Blobs
        if (blob1) gsap.to(blob1, { y: scrollY * 0.14, duration: 0.4, ease: 'power1.out', overwrite: 'auto' });
        if (blob2) gsap.to(blob2, { y: -scrollY * 0.10, duration: 0.4, ease: 'power1.out', overwrite: 'auto' });
        if (blob3) gsap.to(blob3, { y: scrollY * 0.06, duration: 0.4, ease: 'power1.out', overwrite: 'auto' });

        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScrollUpdate);
          ticking = true;
        }
      }, { passive: true });
      onScrollUpdate();

      if (!prefersReducedMotion) {
        // Helper: Inject laser beam if element is a card/container
        function ensureLaserBeam(container) {
          if (!container.querySelector('.laser-lock-in-beam')) {
            const beam = document.createElement('div');
            beam.className = 'laser-lock-in-beam';
            container.appendChild(beam);
            return beam;
          }
          return container.querySelector('.laser-lock-in-beam');
        }

        // 2. High-Tech Section Headers: 3D Horizon Rise & Glow Aperture
        document.querySelectorAll('section > [data-reveal]').forEach(header => {
          const badge = header.querySelector('.glass-badge');
          const heading = header.querySelector('h2, h3');
          const subtitle = header.querySelector('p');

          if (badge || heading) {
            header.dataset.handledReveal = 'true';

            const tl = gsap.timeline({
              scrollTrigger: {
                trigger: header,
                start: 'top 88%',
                once: true
              },
              onStart: () => {
                header.classList.add('revealed');
              },
              onComplete: () => {
                gsap.set(header, { clearProps: 'filter,willChange' });
              }
            });

            gsap.set(header, { opacity: 1 });

            if (badge) {
              tl.fromTo(badge,
                { opacity: 0, y: 16, scale: 0.88 },
                { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: 'back.out(1.8)' }
              );
            }

            if (heading) {
              tl.fromTo(heading,
                { opacity: 0, y: 26, rotationX: 18, transformPerspective: 800 },
                { opacity: 1, y: 0, rotationX: 0, duration: 0.75, ease: 'power3.out' },
                badge ? '-=0.35' : 0
              );
            }

            if (subtitle) {
              tl.fromTo(subtitle,
                { opacity: 0, y: 14, filter: 'blur(5px)' },
                { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' },
                '-=0.45'
              );
            }
          }
        });

        // 3. Concave 3D Matrix Fan-In for Grid Groups ([data-reveal-group])
        document.querySelectorAll('[data-reveal-group]').forEach(group => {
          group.dataset.handledReveal = 'true';
          const items = group.querySelectorAll('.reveal-item');
          if (!items.length) return;

          const totalCols = items.length;

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: group,
              start: 'top 84%',
              once: true
            },
            onStart: () => {
              group.classList.add('revealed');
            }
          });

          items.forEach((item, idx) => {
            const beam = ensureLaserBeam(item);

            let rotY = 0;
            let xOffset = 0;
            if (totalCols === 4) {
              if (idx === 0) { rotY = 9; xOffset = -22; }
              else if (idx === 1) { rotY = 3; xOffset = -8; }
              else if (idx === 2) { rotY = -3; xOffset = 8; }
              else if (idx === 3) { rotY = -9; xOffset = 22; }
            } else if (totalCols === 3) {
              if (idx === 0) { rotY = 8; xOffset = -20; }
              else if (idx === 1) { rotY = 0; xOffset = 0; }
              else if (idx === 2) { rotY = -8; xOffset = 20; }
            }

            gsap.set(item, {
              transformPerspective: 1200,
              transformStyle: 'preserve-3d',
              willChange: 'transform, opacity, filter'
            });

            tl.fromTo(item,
              {
                opacity: 0,
                y: 48,
                x: xOffset,
                rotationX: 14,
                rotationY: rotY,
                scale: 0.93,
                filter: 'blur(8px)'
              },
              {
                opacity: 1,
                y: 0,
                x: 0,
                rotationX: 0,
                rotationY: 0,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.85,
                ease: 'power3.out',
                onStart: () => {
                  item.classList.add('revealed');
                },
                onComplete: () => {
                  gsap.set(item, { clearProps: 'filter,willChange' });
                }
              },
              idx * 0.1
            );

            if (beam) {
              tl.fromTo(beam,
                { scaleX: 0, opacity: 0 },
                { scaleX: 1, opacity: 1, duration: 0.45, ease: 'power2.out' },
                idx * 0.1 + 0.25
              ).to(beam,
                { opacity: 0, duration: 0.35, ease: 'power2.in' },
                idx * 0.1 + 0.65
              );
            }
          });
        });

        // 4. Case Studies: 3D Horizon Unfold + Dynamic Circuit Drawing + Rolling Counters
        document.querySelectorAll('.case-study-card').forEach((card) => {
          card.dataset.handledReveal = 'true';
          const beam = ensureLaserBeam(card);
          const circuitWire1 = card.querySelector('.circuit-wire');
          const circuitWire2 = card.querySelector('.circuit-wire-2');
          const circuitNodes = card.querySelectorAll('.circuit-node');
          const counterEl = card.querySelector('.impact-counter');

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: card,
              start: 'top 85%',
              once: true
            },
            onStart: () => {
              card.classList.add('revealed');
            },
            onComplete: () => {
              gsap.set(card, { clearProps: 'filter,willChange' });
            }
          });

          gsap.set(card, {
            transformPerspective: 1200,
            transformStyle: 'preserve-3d',
            willChange: 'transform, opacity, filter'
          });

          // Card 3D entrance
          tl.fromTo(card,
            {
              opacity: 0,
              y: 50,
              rotationX: 12,
              scale: 0.95,
              filter: 'blur(8px)'
            },
            {
              opacity: 1,
              y: 0,
              rotationX: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.9,
              ease: 'power3.out'
            }
          );

          if (beam) {
            tl.fromTo(beam,
              { scaleX: 0, opacity: 0 },
              { scaleX: 1, opacity: 1, duration: 0.5, ease: 'power2.out' },
              0.25
            ).to(beam,
              { opacity: 0, duration: 0.35, ease: 'power2.in' },
              0.75
            );
          }

          // Dynamic Blueprint Circuit Wire Drawing
          if (circuitWire1 && circuitWire2) {
            tl.fromTo([circuitWire1, circuitWire2],
              { strokeDashoffset: 400 },
              { strokeDashoffset: 0, duration: 1.25, ease: 'power2.inOut' },
              0.2
            );
          }
          if (circuitNodes.length) {
            tl.fromTo(circuitNodes,
              { scale: 0, transformOrigin: 'center' },
              { scale: 1, duration: 0.4, stagger: 0.1, ease: 'back.out(2)' },
              0.65
            );
          }

          // Live Impact Metric Counter Roll
          if (counterEl) {
            const targetStr = counterEl.getAttribute('data-target-num') || '0';
            const suffix = counterEl.getAttribute('data-suffix') || '';
            const targetVal = parseFloat(targetStr);
            const isNegative = targetStr.startsWith('-');
            const countObj = { val: 0 };

            tl.to(countObj, {
              val: targetVal,
              duration: 1.15,
              ease: 'power2.out',
              onUpdate: () => {
                let formatted = targetStr.includes('.') ? countObj.val.toFixed(1) : Math.round(countObj.val);
                if (isNegative && formatted > 0) formatted = '-' + formatted;
                counterEl.textContent = `${formatted}${suffix}`;
              },
              onComplete: () => {
                counterEl.textContent = `${targetStr}${suffix}`;
              }
            }, 0.3);
          }
        });

        // 5. Neural Lab Console: Mainframe Power-Up & Scan Aperture
        const neuralConsole = document.querySelector('#neural-lab .aurora-beam');
        if (neuralConsole) {
          neuralConsole.dataset.handledReveal = 'true';
          const beam = ensureLaserBeam(neuralConsole);

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: neuralConsole,
              start: 'top 84%',
              once: true
            },
            onStart: () => {
              neuralConsole.classList.add('revealed');
            },
            onComplete: () => {
              gsap.set(neuralConsole, { clearProps: 'filter,willChange' });
            }
          });

          gsap.set(neuralConsole, {
            transformPerspective: 1200,
            transformStyle: 'preserve-3d',
            willChange: 'transform, opacity, filter'
          });

          tl.fromTo(neuralConsole,
            {
              opacity: 0,
              y: 50,
              rotationX: 11,
              scale: 0.94,
              filter: 'blur(8px)'
            },
            {
              opacity: 1,
              y: 0,
              rotationX: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.95,
              ease: 'power3.out'
            }
          );

          if (beam) {
            tl.fromTo(beam,
              { scaleX: 0, opacity: 0 },
              { scaleX: 1, opacity: 1, duration: 0.55, ease: 'power2.out' },
              0.3
            ).to(beam,
              { opacity: 0, duration: 0.4, ease: 'power2.in' },
              0.85
            );
          }

          const consolePrompt = neuralConsole.querySelector('#scenario-prompt');
          const scenarioBtns = neuralConsole.querySelectorAll('.scenario-btn');
          if (scenarioBtns.length) {
            tl.fromTo(scenarioBtns,
              { opacity: 0, y: -6 },
              { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: 'power2.out' },
              0.4
            );
          }
          if (consolePrompt) {
            tl.fromTo(consolePrompt,
              { opacity: 0, scale: 0.97 },
              { opacity: 1, scale: 1, duration: 0.5, ease: 'power2.out' },
              0.5
            );
          }
        }

        // 6. Philosophy Data Conduit Energy Pulse
        const conduitTrack = document.getElementById('philosophy-conduit-track');
        const conduitPulse = document.getElementById('conduit-pulse-bead');
        const conduitNodes = document.querySelectorAll('#philosophy-conduit-track .conduit-node');
        if (conduitTrack && conduitPulse) {
          const conduitTL = gsap.timeline({
            scrollTrigger: {
              trigger: conduitTrack,
              start: 'top 85%',
              once: true
            }
          });

          conduitTL.fromTo(conduitPulse,
            { left: '4%', opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.2, ease: 'power1.out' }
          ).to(conduitPulse, {
            left: '96%',
            duration: 1.4,
            ease: 'power1.inOut',
            onUpdate: function() {
              const prog = this.progress();
              conduitNodes.forEach((node, idx) => {
                const threshold = (idx + 0.5) / conduitNodes.length;
                if (prog >= threshold) {
                  node.style.borderColor = 'rgba(56, 189, 248, 0.9)';
                  node.style.boxShadow = '0 0 16px rgba(56, 189, 248, 0.5)';
                }
              });
            }
          }).to(conduitPulse, {
            opacity: 0,
            scale: 0.5,
            duration: 0.3,
            ease: 'power2.in'
          });
        }

        // 7. Hero Visual Card: Page Load 3D Entrance
        const heroVisualWrapper = document.querySelector('header ~ div [data-reveal], .md\\:col-span-5[data-reveal]');
        const heroVisualCard = document.getElementById('hero-telemetry-card');
        if (heroVisualWrapper && heroVisualCard) {
          heroVisualWrapper.dataset.handledReveal = 'true';
          const beam = ensureLaserBeam(heroVisualCard);

          gsap.fromTo(heroVisualWrapper,
            {
              opacity: 0,
              y: 42,
              rotationX: 14,
              rotationY: -6,
              scale: 0.93,
              transformPerspective: 1000,
              filter: 'blur(8px)'
            },
            {
              opacity: 1,
              y: 0,
              rotationX: 0,
              rotationY: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 1.05,
              delay: 0.2,
              ease: 'power3.out',
              onStart: () => {
                heroVisualWrapper.classList.add('revealed');
              },
              onComplete: () => {
                gsap.set(heroVisualWrapper, { clearProps: 'filter,willChange' });
              }
            }
          );

          if (beam) {
            gsap.fromTo(beam,
              { scaleX: 0, opacity: 0 },
              { scaleX: 1, opacity: 1, duration: 0.55, delay: 0.5, ease: 'power2.out' }
            );
            gsap.to(beam,
              { opacity: 0, duration: 0.4, delay: 1.05, ease: 'power2.in' }
            );
          }
        }

        // 8. Contact Collaboration Section
        const contactMain = document.querySelector('#contact [data-reveal]');
        if (contactMain) {
          contactMain.dataset.handledReveal = 'true';
          const beam = ensureLaserBeam(contactMain);
          const contactButtons = contactMain.querySelectorAll('a.glass-panel');

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: contactMain,
              start: 'top 85%',
              once: true
            },
            onStart: () => {
              contactMain.classList.add('revealed');
            },
            onComplete: () => {
              gsap.set(contactMain, { clearProps: 'filter,willChange' });
            }
          });

          gsap.set(contactMain, {
            transformPerspective: 1200,
            transformStyle: 'preserve-3d',
            willChange: 'transform, opacity, filter'
          });

          tl.fromTo(contactMain,
            {
              opacity: 0,
              y: 50,
              rotationX: 14,
              scale: 0.94,
              filter: 'blur(8px)'
            },
            {
              opacity: 1,
              y: 0,
              rotationX: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.9,
              ease: 'power3.out'
            }
          );

          if (beam) {
            tl.fromTo(beam,
              { scaleX: 0, opacity: 0 },
              { scaleX: 1, opacity: 1, duration: 0.5, ease: 'power2.out' },
              0.3
            ).to(beam,
              { opacity: 0, duration: 0.4, ease: 'power2.in' },
              0.8
            );
          }

          if (contactButtons.length) {
            tl.fromTo(contactButtons,
              { opacity: 0, y: 22, scale: 0.9 },
              {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.65,
                stagger: 0.09,
                ease: 'back.out(1.6)',
                onComplete: () => {
                  gsap.set(contactButtons, { clearProps: 'filter,willChange' });
                }
              },
              0.4
            );
          }
        }

        // 9. Universal Fallback for any other [data-reveal]
        document.querySelectorAll('[data-reveal]').forEach(el => {
          if (el.dataset.handledReveal) return;

          gsap.fromTo(el,
            {
              opacity: 0,
              y: 36,
              rotationX: 10,
              scale: 0.96,
              transformPerspective: 1000,
              filter: 'blur(6px)'
            },
            {
              opacity: 1,
              y: 0,
              rotationX: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.85,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                once: true
              },
              onStart: () => {
                el.classList.add('revealed');
              },
              onComplete: () => {
                gsap.set(el, { clearProps: 'filter,willChange' });
              }
            }
          );
        });
      }

      // 3. Fluid GSAP Ambient Cursor Follower (Zero-Jitter quickTo Physics)
      const spotlight = document.getElementById('aurora-mouse-spotlight');
      if (spotlight) {
        gsap.set(spotlight, { xPercent: -50, yPercent: -50 });
        const xTo = gsap.quickTo(spotlight, 'x', { duration: 0.65, ease: 'power3.out' });
        const yTo = gsap.quickTo(spotlight, 'y', { duration: 0.65, ease: 'power3.out' });

        let isMoving = false;
        window.addEventListener('pointermove', (e) => {
          if (!isMoving) {
            gsap.to(spotlight, { opacity: 1, duration: 0.5, ease: 'power2.out' });
            isMoving = true;
          }
          xTo(e.clientX);
          yTo(e.clientY);
        }, { passive: true });
      }

      // 4. Kinetic Magnetic Physics & Live Decrypt Protocols on Contact Section
      const contactCards = document.querySelectorAll('#contact .contact-channel-card, #contact a.glass-panel');
      const cyberGlyphs = '01#_@$*<>[{]}+=~Δλ';

      contactCards.forEach(card => {
        gsap.set(card, { transformPerspective: 900, transformStyle: 'preserve-3d' });

        const xTo = gsap.quickTo(card, 'x', { duration: 0.35, ease: 'power2.out' });
        const yTo = gsap.quickTo(card, 'y', { duration: 0.35, ease: 'power2.out' });
        const rotXTo = gsap.quickTo(card, 'rotationX', { duration: 0.3, ease: 'power2.out' });
        const rotYTo = gsap.quickTo(card, 'rotationY', { duration: 0.3, ease: 'power2.out' });

        const signalTag = card.querySelector('.signal-status-tag');
        const originalText = signalTag?.getAttribute('data-original') || signalTag?.textContent || '';
        const targetSignal = card.getAttribute('data-signal') || 'SESSION_CONNECTED';
        let scrambleInterval;
        let isHovered = false;

        card.addEventListener('pointerenter', () => {
          isHovered = true;
          gsap.to(card, {
            scale: 1.045,
            duration: 0.35,
            ease: 'power2.out',
            overwrite: 'auto'
          });

          // Live hacker decrypt protocol handshake
          if (signalTag) {
            clearInterval(scrambleInterval);
            let iteration = 0;
            const fullTarget = `> PROTOCOL: ${targetSignal}`;
            scrambleInterval = setInterval(() => {
              signalTag.textContent = fullTarget
                .split('')
                .map((char, index) => {
                  if (index < iteration) return fullTarget[index];
                  if (char === ' ') return ' ';
                  return cyberGlyphs[Math.floor(Math.random() * cyberGlyphs.length)];
                })
                .join('');

              if (iteration >= fullTarget.length) {
                clearInterval(scrambleInterval);
                signalTag.textContent = fullTarget;
              }
              iteration += 1.5;
            }, 22);
          }
        });

        card.addEventListener('pointermove', (e) => {
          if (!isHovered) return;
          e.stopPropagation();

          const rect = card.getBoundingClientRect();
          const relX = e.clientX - (rect.left + rect.width / 2);
          const relY = e.clientY - (rect.top + rect.height / 2);

          // Kinetic magnetic pull towards cursor (moves physically toward cursor position)
          xTo(relX * 0.28);
          yTo(relY * 0.28);

          // 3D gyroscopic tilt
          const maxTilt = 9.5;
          const rotateX = (relY / (rect.height / 2)) * -maxTilt;
          const rotateY = (relX / (rect.width / 2)) * maxTilt;
          rotXTo(rotateX);
          rotYTo(rotateY);
        });

        card.addEventListener('pointerleave', () => {
          isHovered = false;
          clearInterval(scrambleInterval);
          if (signalTag) signalTag.textContent = originalText;

          // High-fidelity elastic snap-back physics
          gsap.to(card, {
            x: 0,
            y: 0,
            rotationX: 0,
            rotationY: 0,
            scale: 1,
            duration: 0.95,
            ease: 'elastic.out(1, 0.45)',
            overwrite: 'auto'
          });
        });

        // Tactile press feedback
        card.addEventListener('pointerdown', () => {
          gsap.to(card, { scale: 0.98, duration: 0.15, ease: 'power2.out' });
        });
        card.addEventListener('pointerup', () => {
          gsap.to(card, { scale: 1.045, duration: 0.25, ease: 'power2.out' });
        });
      });

      // Outer contact container subtle 3D perspective tilt
      const contactContainer = document.querySelector('#contact > div.glass-panel');
      if (contactContainer) {
        gsap.set(contactContainer, { transformPerspective: 1400, transformStyle: 'preserve-3d' });
        const cRotXTo = gsap.quickTo(contactContainer, 'rotationX', { duration: 0.4, ease: 'power2.out' });
        const cRotYTo = gsap.quickTo(contactContainer, 'rotationY', { duration: 0.4, ease: 'power2.out' });

        let isContainerHovered = false;
        contactContainer.addEventListener('pointerenter', () => {
          isContainerHovered = true;
          gsap.to(contactContainer, { y: -3, scale: 1.005, duration: 0.4, ease: 'power2.out', overwrite: 'auto' });
        });
        contactContainer.addEventListener('pointermove', (e) => {
          if (!isContainerHovered) return;
          const rect = contactContainer.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          cRotXTo(((y - centerY) / centerY) * -2.5);
          cRotYTo(((x - centerX) / centerX) * 2.5);
        });
        contactContainer.addEventListener('pointerleave', () => {
          isContainerHovered = false;
          gsap.to(contactContainer, {
            rotationX: 0,
            rotationY: 0,
            y: 0,
            scale: 1,
            duration: 0.8,
            ease: 'power3.out',
            overwrite: 'auto'
          });
        });
      }

      // 5. Genuinely Novel Interactive Engines (Beyond "Lift + Glow")
      
      // A. Philosophy: Cryptographic Hacker Text Decrypt Engine
      document.querySelectorAll('.philosophy-card').forEach(card => {
        const titleEl = card.querySelector('.scramble-target');
        if (!titleEl) return;
        const originalText = titleEl.getAttribute('data-original-text') || titleEl.textContent || '';
        let scrambleInterval;

        card.addEventListener('pointerenter', () => {
          clearInterval(scrambleInterval);
          let iteration = 0;
          scrambleInterval = setInterval(() => {
            titleEl.textContent = originalText
              .split('')
              .map((char, index) => {
                if (index < iteration) {
                  return originalText[index];
                }
                if (char === ' ') return ' ';
                return cyberGlyphs[Math.floor(Math.random() * cyberGlyphs.length)];
              })
              .join('');

            if (iteration >= originalText.length) {
              clearInterval(scrambleInterval);
              titleEl.textContent = originalText;
            }
            iteration += 1 / 2;
          }, 24);
        });

        card.addEventListener('pointerleave', () => {
          clearInterval(scrambleInterval);
          titleEl.textContent = originalText;
        });
      });

      // B. Case Studies: 3D Kinetic Tilt, Specular Mouse Tracker & Rolling Counter
      document.querySelectorAll('.case-study-card').forEach(card => {
        gsap.set(card, { transformPerspective: 950, transformStyle: 'preserve-3d' });

        const rotXTo = gsap.quickTo(card, 'rotationX', { duration: 0.35, ease: 'power2.out' });
        const rotYTo = gsap.quickTo(card, 'rotationY', { duration: 0.35, ease: 'power2.out' });
        const yTo = gsap.quickTo(card, 'y', { duration: 0.35, ease: 'power2.out' });

        const counterEl = card.querySelector('.impact-counter');
        const targetStr = counterEl?.getAttribute('data-target-num') || '0';
        const suffix = counterEl?.getAttribute('data-suffix') || '';
        const targetVal = parseFloat(targetStr);
        const isNegative = targetStr.startsWith('-');

        let countObj = { val: 0 };
        let counterTween;
        let isCardHovered = false;

        card.addEventListener('pointerenter', () => {
          isCardHovered = true;
          gsap.to(card, {
            scale: 1.025,
            duration: 0.35,
            ease: 'power2.out',
            overwrite: 'auto'
          });
          yTo(-8);

          // Rolling Metric Counter
          if (counterEl) {
            if (counterTween) counterTween.kill();
            countObj.val = 0;
            counterTween = gsap.to(countObj, {
              val: targetVal,
              duration: 0.65,
              ease: 'power2.out',
              onUpdate: () => {
                let formatted = targetStr.includes('.') ? countObj.val.toFixed(1) : Math.round(countObj.val);
                if (isNegative && formatted > 0) formatted = '-' + formatted;
                counterEl.textContent = `${formatted}${suffix}`;
              },
              onComplete: () => {
                counterEl.textContent = `${targetStr}${suffix}`;
              }
            });
          }
        });

        card.addEventListener('pointermove', (e) => {
          if (!isCardHovered) return;
          const rect = card.getBoundingClientRect();
          const relX = e.clientX - rect.left;
          const relY = e.clientY - rect.top;

          // Track specular glare position
          const xPercent = (relX / rect.width) * 100;
          const yPercent = (relY / rect.height) * 100;
          card.style.setProperty('--mouse-x', `${xPercent}%`);
          card.style.setProperty('--mouse-y', `${yPercent}%`);

          // 3D gyroscopic tilt
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const maxTilt = 8.5;
          const rotateX = ((relY - centerY) / centerY) * -maxTilt;
          const rotateY = ((relX - centerX) / centerX) * maxTilt;

          rotXTo(rotateX);
          rotYTo(rotateY);
        });

        card.addEventListener('pointerleave', () => {
          isCardHovered = false;
          if (counterTween) counterTween.kill();
          if (counterEl) counterEl.textContent = `${targetStr}${suffix}`;

          // Elastic snap-back rebound physics
          gsap.to(card, {
            x: 0,
            y: 0,
            rotationX: 0,
            rotationY: 0,
            scale: 1,
            duration: 0.9,
            ease: 'elastic.out(1, 0.45)',
            overwrite: 'auto'
          });
        });

        // Tactile Press
        card.addEventListener('pointerdown', () => {
          gsap.to(card, { scale: 0.985, duration: 0.15, ease: 'power2.out' });
        });
        card.addEventListener('pointerup', () => {
          gsap.to(card, { scale: 1.025, duration: 0.25, ease: 'power2.out' });
        });
      });

      // C. Capabilities Bento: 3D Kinetic Tilt, Layer Scramble & Chip Waves
      document.querySelectorAll('.bento-card').forEach(card => {
        gsap.set(card, { transformPerspective: 950, transformStyle: 'preserve-3d' });

        const rotXTo = gsap.quickTo(card, 'rotationX', { duration: 0.35, ease: 'power2.out' });
        const rotYTo = gsap.quickTo(card, 'rotationY', { duration: 0.35, ease: 'power2.out' });
        const yTo = gsap.quickTo(card, 'y', { duration: 0.35, ease: 'power2.out' });

        const layerTag = card.querySelector('.bento-layer-tag');
        const originalLayerText = layerTag?.getAttribute('data-original') || layerTag?.textContent || '';
        const chips = card.querySelectorAll('.kinetic-chip');
        let scrambleInterval;
        let isCardHovered = false;

        card.addEventListener('pointerenter', () => {
          isCardHovered = true;
          gsap.to(card, {
            scale: 1.025,
            duration: 0.35,
            ease: 'power2.out',
            overwrite: 'auto'
          });
          yTo(-8);

          // Wave Stagger on Chips
          if (chips.length) {
            gsap.to(chips, {
              y: -3,
              stagger: 0.035,
              duration: 0.28,
              ease: 'power2.out',
              overwrite: 'auto'
            });
          }

          // Layer Tag Hacker Decrypt Scramble
          if (layerTag) {
            clearInterval(scrambleInterval);
            let iteration = 0;
            scrambleInterval = setInterval(() => {
              layerTag.textContent = originalLayerText
                .split('')
                .map((char, index) => {
                  if (index < iteration) return originalLayerText[index];
                  if (char === '_') return '_';
                  return cyberGlyphs[Math.floor(Math.random() * cyberGlyphs.length)];
                })
                .join('');

              if (iteration >= originalLayerText.length) {
                clearInterval(scrambleInterval);
                layerTag.textContent = originalLayerText;
              }
              iteration += 1.2;
            }, 22);
          }
        });

        card.addEventListener('pointermove', (e) => {
          if (!isCardHovered) return;
          const rect = card.getBoundingClientRect();
          const relX = e.clientX - rect.left;
          const relY = e.clientY - rect.top;

          // Track specular glare position
          const xPercent = (relX / rect.width) * 100;
          const yPercent = (relY / rect.height) * 100;
          card.style.setProperty('--mouse-x', `${xPercent}%`);
          card.style.setProperty('--mouse-y', `${yPercent}%`);

          // 3D gyroscopic tilt
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const maxTilt = 8.5;
          const rotateX = ((relY - centerY) / centerY) * -maxTilt;
          const rotateY = ((relX - centerX) / centerX) * maxTilt;

          rotXTo(rotateX);
          rotYTo(rotateY);
        });

        card.addEventListener('pointerleave', () => {
          isCardHovered = false;
          clearInterval(scrambleInterval);
          if (layerTag) layerTag.textContent = originalLayerText;

          // Reset Chips Wave
          if (chips.length) {
            gsap.to(chips, {
              y: 0,
              stagger: 0.02,
              duration: 0.35,
              ease: 'power2.out',
              overwrite: 'auto'
            });
          }

          // Elastic snap-back rebound physics
          gsap.to(card, {
            x: 0,
            y: 0,
            rotationX: 0,
            rotationY: 0,
            scale: 1,
            duration: 0.9,
            ease: 'elastic.out(1, 0.45)',
            overwrite: 'auto'
          });
        });

        // Tactile Press
        card.addEventListener('pointerdown', () => {
          gsap.to(card, { scale: 0.985, duration: 0.15, ease: 'power2.out' });
        });
        card.addEventListener('pointerup', () => {
          gsap.to(card, { scale: 1.025, duration: 0.25, ease: 'power2.out' });
        });
      });

      // Individual kinetic chip hover boost
      document.querySelectorAll('.bento-card .kinetic-chip').forEach(chip => {
        chip.addEventListener('pointerenter', () => {
          gsap.to(chip, { scale: 1.15, y: -4, duration: 0.18, ease: 'back.out(2)', overwrite: 'auto' });
        });
        chip.addEventListener('pointerleave', () => {
          gsap.to(chip, { scale: 1, y: 0, duration: 0.28, ease: 'power2.out', overwrite: 'auto' });
        });
      });

      // D. About Bento Cards: Pure Stable Elevation, Specular Light Sheen Tracker & Tactile Feedback
      document.querySelectorAll('.about-bento-card').forEach(card => {
        const yTo = gsap.quickTo(card, 'y', { duration: 0.35, ease: 'power2.out' });
        const chips = card.querySelectorAll('.about-value-chip');
        let isCardHovered = false;

        card.addEventListener('pointerenter', () => {
          isCardHovered = true;
          gsap.to(card, {
            scale: 1.015,
            duration: 0.32,
            ease: 'power2.out',
            overwrite: 'auto'
          });
          yTo(-6);

          if (chips.length) {
            gsap.to(chips, {
              y: -2,
              stagger: 0.03,
              duration: 0.25,
              ease: 'power2.out',
              overwrite: 'auto'
            });
          }
        });

        card.addEventListener('pointermove', (e) => {
          if (!isCardHovered) return;
          const rect = card.getBoundingClientRect();
          const relX = e.clientX - rect.left;
          const relY = e.clientY - rect.top;

          // Track specular glare position
          const xPercent = (relX / rect.width) * 100;
          const yPercent = (relY / rect.height) * 100;
          card.style.setProperty('--mouse-x', `${xPercent}%`);
          card.style.setProperty('--mouse-y', `${yPercent}%`);
        });

        card.addEventListener('pointerleave', () => {
          isCardHovered = false;
          if (chips.length) {
            gsap.to(chips, {
              y: 0,
              stagger: 0.02,
              duration: 0.3,
              ease: 'power2.out',
              overwrite: 'auto'
            });
          }

          gsap.to(card, {
            y: 0,
            scale: 1,
            duration: 0.5,
            ease: 'power2.out',
            overwrite: 'auto'
          });
        });

        // Tactile Press
        card.addEventListener('pointerdown', () => {
          gsap.to(card, { scale: 0.99, duration: 0.15, ease: 'power2.out' });
        });
        card.addEventListener('pointerup', () => {
          gsap.to(card, { scale: 1.015, duration: 0.25, ease: 'power2.out' });
        });
      });

      // Hero Visual Card: Autonomous AI Neural Telemetry Core Engine
      const heroCard = document.getElementById('hero-telemetry-card');
      if (heroCard) {
        // Ambient zero-gravity floating levitation
        const floatTween = gsap.to(heroCard, {
          y: -8,
          duration: 3.4,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut'
        });

        const scanBeam = document.getElementById('hero-scan-beam');
        const items = heroCard.querySelectorAll('.telemetry-item');
        const orb = document.getElementById('hero-orb');
        const latencyEl = document.getElementById('hero-latency-val');
        const tokCounter = document.getElementById('hero-tok-counter');
        const wavePath = document.getElementById('hero-neural-wave-path');
        const probeSonar = document.getElementById('hero-probe-sonar');
        const headerLayer = heroCard.querySelector('.hero-card-layer-header');
        const contentLayer = heroCard.querySelector('.hero-card-layer-content');
        const agentStatus = document.getElementById('hero-agent-status');
        const pingBadge = document.getElementById('hero-ping-badge');

        // 1. Live Mathematical Oscilloscope Waveform Synthesizer (60 FPS Harmonic Waves)
        let waveT = 0;
        let waveAmp = 4;
        let targetWaveAmp = 4;
        let waveSpeed = 0.05;
        let targetWaveSpeed = 0.05;

        function renderOscilloscope() {
          if (!wavePath) return;
          // Fluidly interpolate amplitude & speed
          waveAmp += (targetWaveAmp - waveAmp) * 0.12;
          waveSpeed += (targetWaveSpeed - waveSpeed) * 0.12;
          waveT += waveSpeed;

          const segments = 14;
          const dx = 300 / segments;
          let d = '';
          for (let i = 0; i <= segments; i++) {
            const x = i * dx;
            // Compound harmonic sinusoidal physics
            const y = 12 + Math.sin(i * 0.65 + waveT) * waveAmp + Math.cos(i * 1.35 - waveT * 1.25) * (waveAmp * 0.45);
            d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1) + ' ';
          }
          wavePath.setAttribute('d', d.trim());
        }
        gsap.ticker.add(renderOscilloscope);

        // 2. Real-Time Telemetry Latency & Live Token Stream Fluctuator
        let latencyInterval;
        if (latencyEl) {
          latencyInterval = setInterval(() => {
            const randMs = 138 + Math.floor(Math.random() * 8);
            latencyEl.textContent = randMs + 'ms';
          }, 2400);
        }

        let tokInterval;
        let baseTok = 48.2;

        // 3. Multi-Layer 3D Gyroscopic Parallax Tracking
        gsap.set(heroCard, { transformPerspective: 1200, transformStyle: 'preserve-3d' });
        const cRotXTo = gsap.quickTo(heroCard, 'rotationX', { duration: 0.35, ease: 'power2.out' });
        const cRotYTo = gsap.quickTo(heroCard, 'rotationY', { duration: 0.35, ease: 'power2.out' });
        const hXTo = headerLayer ? gsap.quickTo(headerLayer, 'x', { duration: 0.35, ease: 'power2.out' }) : null;
        const hYTo = headerLayer ? gsap.quickTo(headerLayer, 'y', { duration: 0.35, ease: 'power2.out' }) : null;
        const ctxXTo = contentLayer ? gsap.quickTo(contentLayer, 'x', { duration: 0.35, ease: 'power2.out' }) : null;
        const ctxYTo = contentLayer ? gsap.quickTo(contentLayer, 'y', { duration: 0.35, ease: 'power2.out' }) : null;
        const orbXTo = orb ? gsap.quickTo(orb, 'x', { duration: 0.4, ease: 'power2.out' }) : null;
        const orbYTo = orb ? gsap.quickTo(orb, 'y', { duration: 0.4, ease: 'power2.out' }) : null;

        let isHovered = false;

        heroCard.addEventListener('pointermove', (e) => {
          const rect = heroCard.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          heroCard.style.setProperty('--mouse-x', `${x}%`);
          heroCard.style.setProperty('--mouse-y', `${y}%`);

          if (!isHovered) return;

          const relX = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const relY = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);

          // 3D tilt
          cRotXTo(relY * -6);
          cRotYTo(relX * 6);

          // Internal layers multi-depth parallax
          if (hXTo && hYTo) {
            hXTo(relX * 7);
            hYTo(relY * 7);
          }
          if (ctxXTo && ctxYTo) {
            ctxXTo(relX * 4);
            ctxYTo(relY * 4);
          }
          if (orbXTo && orbYTo) {
            orbXTo(-relX * 16);
            orbYTo(-relY * 16);
          }
        });

        // Hover: Excite Neural Oscilloscope, Token Burst, and Specular Lift
        heroCard.addEventListener('pointerenter', () => {
          isHovered = true;
          floatTween.pause();

          // Excite Waveform Synthesizer
          targetWaveAmp = 8.8;
          targetWaveSpeed = 0.11;

          gsap.to(heroCard, {
            y: -14,
            scale: 1.025,
            duration: 0.45,
            ease: 'power2.out',
            overwrite: 'auto'
          });

          // Telemetry rows micro-elevation
          gsap.to(items, {
            y: -3,
            stagger: 0.05,
            duration: 0.35,
            ease: 'power2.out',
            overwrite: 'auto'
          });

          if (orb) {
            gsap.to(orb, { scale: 1.45, opacity: 0.45, duration: 0.5, ease: 'power2.out' });
          }

          // Trigger energetic holographic diagnostic scan down the card
          if (scanBeam) {
            gsap.fromTo(scanBeam,
              { top: '-60px', opacity: 0.95 },
              { top: '105%', opacity: 0, duration: 1.15, ease: 'power2.inOut' }
            );
          }

          // Live High-Speed Token Stream Fluctuations
          if (tokCounter) {
            clearInterval(tokInterval);
            tokInterval = setInterval(() => {
              const spike = (baseTok + (Math.random() * 4.6 - 1.2)).toFixed(1);
              tokCounter.textContent = `${spike}k tok/s`;
            }, 120);
          }
        });

        // Leave: Settle Back Smoothly to Peaceful Ambient Drift
        heroCard.addEventListener('pointerleave', () => {
          isHovered = false;
          clearInterval(tokInterval);
          if (tokCounter) tokCounter.textContent = '48.2k tok/s';

          // Calm Waveform Synthesizer
          targetWaveAmp = 4;
          targetWaveSpeed = 0.05;

          // Reset Parallax
          cRotXTo(0);
          cRotYTo(0);
          if (hXTo && hYTo) { hXTo(0); hYTo(0); }
          if (ctxXTo && ctxYTo) { ctxXTo(0); ctxYTo(0); }
          if (orbXTo && orbYTo) { orbXTo(0); orbYTo(0); }

          gsap.to(heroCard, {
            y: 0,
            rotationX: 0,
            rotationY: 0,
            scale: 1,
            duration: 0.85,
            ease: 'power3.out',
            overwrite: 'auto',
            onComplete: () => {
              floatTween.resume();
            }
          });

          gsap.to(items, {
            y: 0,
            stagger: 0.03,
            duration: 0.5,
            ease: 'power3.out',
            overwrite: 'auto'
          });

          if (orb) {
            gsap.to(orb, { scale: 1, opacity: 0.15, duration: 0.7, ease: 'power3.out' });
          }
        });

        // 4. Interactive Click: Diagnostic Probe Ping Wave
        heroCard.addEventListener('click', (e) => {
          const rect = heroCard.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const clickY = e.clientY - rect.top;

          // Create dynamic sonar ring
          if (probeSonar) {
            const ring = document.createElement('div');
            ring.className = 'hero-probe-sonar-ring';
            ring.style.left = `${clickX}px`;
            ring.style.top = `${clickY}px`;
            probeSonar.appendChild(ring);
            setTimeout(() => ring.remove(), 900);
          }

          // Fire fast scanline beam
          if (scanBeam) {
            gsap.fromTo(scanBeam,
              { top: '-60px', opacity: 1 },
              { top: '105%', opacity: 0, duration: 0.7, ease: 'power2.inOut' }
            );
          }

          // Temporary Accelerated Probe State
          if (agentStatus) {
            agentStatus.textContent = 'PROBING...';
            agentStatus.classList.remove('text-emerald-400');
            agentStatus.classList.add('text-sky-frost');
          }
          if (pingBadge) {
            pingBadge.textContent = '94ms [ACCEL]';
            pingBadge.classList.add('bg-sky-500/20', 'border-sky-400');
          }
          if (latencyEl) {
            latencyEl.textContent = '94ms';
            latencyEl.classList.remove('text-sky-frost');
            latencyEl.classList.add('text-emerald-400');
          }

          // Reset back to active after probe completes
          setTimeout(() => {
            if (agentStatus) {
              agentStatus.textContent = 'Active';
              agentStatus.classList.remove('text-sky-frost');
              agentStatus.classList.add('text-emerald-400');
            }
            if (pingBadge) {
              pingBadge.textContent = 'LIVE PING';
              pingBadge.classList.remove('bg-sky-500/20', 'border-sky-400');
            }
            if (latencyEl) {
              latencyEl.classList.remove('text-emerald-400');
              latencyEl.classList.add('text-sky-frost');
            }
          }, 1800);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMotionEngine);
    } else {
      initMotionEngine();
    }
    document.addEventListener('astro:page-load', initMotionEngine);
  </script>
</body>
</html>
